@using CSM.Web.Services

@inject IAuthService AuthService
@inject ILogger<PermissionView> Logger

@if (_hasPermission)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired]
    public string[] AnyOf { get; set; } = [];

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _hasPermission;

    protected override async Task OnParametersSetAsync()
    {
        _hasPermission = false;

        try
        {
            var permissions = await AuthService.GetPermissionsAsync();
            _hasPermission = AnyOf.Any(permissions.Contains);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not verify permissions for a protected UI action.");
        }
    }
}
