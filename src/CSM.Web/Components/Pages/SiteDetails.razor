@page "/sites/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Models.Projects
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Site Dashboard</PageTitle>

@if (_loading)
{
    <div class="container py-4">
        <h4>Loading site...</h4>
    </div>
}
else if (_site is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">
            Site not found.
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>
                <button class="btn btn-outline-secondary mb-3"
                        @onclick='() => Navigation.NavigateTo("/sites-management")'>
                    ← Construction Sites
                </button>

                <h2 class="mb-1">@_site.Name</h2>

                <div class="text-muted mb-2">
                    @_site.SiteCode · @_site.City, @_site.Region
                </div>

                <div class="d-flex gap-2">
                    <span class="@StatusBadge(_site.Status)">
                        @_site.Status
                    </span>
                </div>
            </div>

            <PermissionView AnyOf="@SiteManagePermission">
                <button class="btn btn-primary"
                        @onclick='() => Navigation.NavigateTo($"/sites/edit/{SiteId}")'>
                    Edit Site
                </button>
            </PermissionView>

        </div>

        <!-- KPI -->
        <PermissionView AnyOf="@ProjectViewPermission">
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-muted">Projects</div>
                        <h2>@_projectCount</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-muted">Active</div>
                        <h2>@_activeProjects</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-muted">Contract Value</div>
                        <h5>ETB @_contractValue.ToString("N0")</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-muted">Average Progress</div>
                        <h2>@_averageProgress%</h2>
                    </div>
                </div>
            </div>

        </div>
        </PermissionView>

        <!-- Site Information -->
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">Site Information</h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <p>
                            <strong>Site Code:</strong> @_site.SiteCode
                        </p>

                        <p>
                            <strong>Address:</strong> @_site.Address
                        </p>

                        <p>
                            <strong>City:</strong> @_site.City
                        </p>

                        <p>
                            <strong>Region:</strong> @_site.Region
                        </p>

                        <p>
                            <strong>Country:</strong> @_site.Country
                        </p>

                    </div>

                    <div class="col-md-6">

                        <p>
                            <strong>Latitude:</strong> @_site.Latitude
                        </p>

                        <p>
                            <strong>Longitude:</strong> @_site.Longitude
                        </p>

                        <p>
                            <strong>Geofence:</strong> @_site.GeofenceRadiusMeters m
                        </p>

                        <p>
                            <strong>Planned Start:</strong>
                            @_site.PlannedStartDate?.ToString("dd MMM yyyy")
                        </p>

                        <p>
                            <strong>Planned Finish:</strong>
                            @_site.PlannedEndDate?.ToString("dd MMM yyyy")
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <PermissionView AnyOf="@SiteManagePermission">
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Site Status</strong>
            </div>

            <div class="card-body">

                <div class="row align-items-end">

                    <div class="col-md-8">
                        <label class="form-label">Current Status</label>

                        <InputSelect class="form-select"
                                     @bind-Value="SelectedStatus">

                            @foreach (var status in Enum.GetValues<SiteStatus>())
                            {
                                <option value="@status">@status</option>
                            }

                        </InputSelect>

                        <div class="text-muted mt-2">
                            Selected: @SelectedStatus
                        </div>
                    </div>

                    <div class="col-md-4 d-grid">
                        <button class="btn btn-primary"
                                @onclick="UpdateStatus">
                            Update Status
                        </button>
                    </div>

                </div>

            </div>
        </div>
        </PermissionView>

        <!-- Quick Modules -->
        <h5 class="mb-3">Site Modules</h5>
        <div class="row g-3 mb-4">

            <PermissionView AnyOf="@ProjectViewPermission">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 module-card"
                         style="cursor:pointer"
                         @onclick="OpenProjects">
                        <div class="card-body text-center p-3">
                            <div class="display-6 text-primary">
                                <span class="bi bi-folder"></span>
                            </div>
                            <h6 class="mt-2 mb-1 fw-bold">Projects</h6>
                            <p class="text-muted small mb-0">
                                View projects assigned to site
                            </p>
                        </div>
                    </div>
                </div>
            </PermissionView>

            <PermissionView AnyOf="@HrmViewPermissions">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 module-card"
                         style="cursor:pointer"
                         @onclick="OpenWorkforce">
                        <div class="card-body text-center p-3">
                            <div class="display-6 text-success">
                                <span class="bi bi-people"></span>
                            </div>
                            <h6 class="mt-2 mb-1 fw-bold">Workforce</h6>
                            <p class="text-muted small mb-0">
                                Manage workers & assignments
                            </p>
                        </div>
                    </div>
                </div>
            </PermissionView>

            <PermissionView AnyOf="@InventoryViewPermissions">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 module-card"
                         style="cursor:pointer"
                         @onclick="OpenInventory">
                        <div class="card-body text-center p-3">
                            <div class="display-6 text-warning">
                                <span class="bi bi-box-seam"></span>
                            </div>
                            <h6 class="mt-2 mb-1 fw-bold">Inventory</h6>
                            <p class="text-muted small mb-0">
                                Track stock & material movements
                            </p>
                        </div>
                    </div>
                </div>
            </PermissionView>

            <PermissionView AnyOf="@EquipmentViewPermission">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 module-card"
                         style="cursor:pointer"
                         @onclick="OpenEquipment">
                        <div class="card-body text-center p-3">
                            <div class="display-6 text-info">
                                <span class="bi bi-truck"></span>
                            </div>
                            <h6 class="mt-2 mb-1 fw-bold">Equipment</h6>
                            <p class="text-muted small mb-0">
                                Machinery & asset assignments
                            </p>
                        </div>
                    </div>
                </div>
            </PermissionView>

            <PermissionView AnyOf="@FinanceViewPermissions">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 module-card"
                         style="cursor:pointer"
                         @onclick="OpenFinance">
                        <div class="card-body text-center p-3">
                            <div class="display-6 text-primary">
                                <span class="bi bi-wallet2"></span>
                            </div>
                            <h6 class="mt-2 mb-1 fw-bold">Finance</h6>
                            <p class="text-muted small mb-0">
                                Site budget & expenses summary
                            </p>
                        </div>
                    </div>
                </div>
            </PermissionView>

            <PermissionView AnyOf="@ComplianceViewPermission">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="card shadow-sm h-100 module-card"
                         style="cursor:pointer"
                         @onclick="OpenCompliance">
                        <div class="card-body text-center p-3">
                            <div class="display-6 text-danger">
                                <span class="bi bi-shield-check"></span>
                            </div>
                            <h6 class="mt-2 mb-1 fw-bold">Compliance</h6>
                            <p class="text-muted small mb-0">
                                Safety incidents & inspections
                            </p>
                        </div>
                    </div>
                </div>
            </PermissionView>

        </div>

        <!-- Projects -->
        <PermissionView AnyOf="@ProjectViewPermission">
        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">Site Projects</h5>

                <button class="btn btn-sm btn-primary"
                        @onclick='() => Navigation.NavigateTo($"/sites/{SiteId}/projects")'>
                    View All
                </button>

            </div>

            <div class="card-body p-0">

                @if (_siteProjects.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        No projects assigned to this construction site.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Project</th>
                                    <th>Status</th>
                                    <th width="220">Progress</th>
                                    <th width="90"></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var project in _siteProjects.Take(5))
                                {
                                    <tr>

                                        <td>
                                            <strong>@project.Code</strong>
                                        </td>

                                        <td>@project.Name</td>

                                        <td>
                                            <span class="@StatusBadge(project.Status)">
                                                @project.Status
                                            </span>
                                        </td>

                                        <td>

                                            <div class="d-flex justify-content-between small mb-1">
                                                <span>@project.ProgressPercentage%</span>
                                            </div>

                                            <div class="progress" style="height:8px;">
                                                <div class="progress-bar bg-success"
                                                     role="progressbar"
                                                     style="width:@($"{project.ProgressPercentage}%")">
                                                </div>
                                            </div>

                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ViewProject(project.Id)">
                                                Open
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
        </PermissionView>

    </div>
}

@code {
    private static readonly string[] SiteManagePermission = ["Sites_Manage"];
    private static readonly string[] ProjectViewPermission = ["Projects_View"];
    private static readonly string[] HrmViewPermissions = ["HRM_Employee_View", "HRM_Attendance_View", "HRM_Timesheet_View", "HRM_Leave_View", "HRM_Payroll_View"];
    private static readonly string[] InventoryViewPermissions = ["Procurement_Inventory_View", "Procurement_MaterialRequest_View"];
    private static readonly string[] EquipmentViewPermission = ["Equipment_View"];
    private static readonly string[] FinanceViewPermissions = ["Finance_Budget_View", "Finance_Expense_View", "Finance_Invoice_View", "Finance_Payment_View"];
    private static readonly string[] ComplianceViewPermission = ["Compliance_View"];


    [Parameter]
    public Guid SiteId { get; set; }

    private SiteResponse? _site;

    private SiteStatus SelectedStatus;

    private bool _loading = true;
    private bool _loaded;

    private List<ProjectSummary> _siteProjects = [];

    private int _projectCount;
    private int _activeProjects;
    private decimal _contractValue;
    private int _averageProgress;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        _site = await ProjectService.GetSiteAsync(SiteId);

        if (_site is null)
        {
            Navigation.NavigateTo("/project-tracking");
            return;
        }

        SelectedStatus = Enum.TryParse<SiteStatus>(
            _site.Status,
            out var status)
                ? status
                : SiteStatus.Planning;

        var permissions = await AuthService.GetPermissionsAsync();
        if (permissions.Contains("Projects_View"))
        {
            var projects = await ProjectService.GetProjectsAsync();

            _siteProjects = projects
                .Where(x => x.ConstructionSiteId == SiteId)
                .OrderBy(x => x.Name)
                .ToList();

            _projectCount = _siteProjects.Count;
            _activeProjects = _siteProjects.Count(x => x.Status == "Active");
            _contractValue = _siteProjects.Sum(x => x.ContractValue);

            _averageProgress = _siteProjects.Count == 0
                ? 0
                : (int)Math.Round(_siteProjects.Average(x => x.ProgressPercentage));
        }

        _loading = false;

        StateHasChanged();
    }

    private async Task UpdateStatus()
    {
        _site = await ProjectService.ChangeSiteStatusAsync(
            SiteId,
            SelectedStatus);

        SelectedStatus = Enum.TryParse<SiteStatus>(
            _site.Status,
            out var status)
                ? status
                : SiteStatus.Planning;

        StateHasChanged();
    }

    private void Back()
    {
        Navigation.NavigateTo("/sites-management");
    }

    private void EditSite()
    {
        Navigation.NavigateTo($"/sites/edit/{SiteId}");
    }

    private void OpenProjects()
    {
        Navigation.NavigateTo($"/sites/{SiteId}/projects");
    }

    private void OpenWorkforce()
    {
        Navigation.NavigateTo($"/hr/employees/site/{SiteId}");
    }

    private void OpenInventory()
    {
        Navigation.NavigateTo($"/stock-balance/site/{SiteId}");
    }

    private void OpenEquipment()
    {
        Navigation.NavigateTo($"/equipment/assignments/site/{SiteId}");
    }

    private void OpenFinance()
    {
        Navigation.NavigateTo($"/finance/summary/site/{SiteId}");
    }

    private void OpenCompliance()
    {
        Navigation.NavigateTo("/compliance");
    }

    private void ViewProject(Guid id)
    {
        Navigation.NavigateTo($"/projects/{id}");
    }

    private static string StatusBadge(string status) => status switch
    {
        "Active" => "badge bg-success",
        "Planning" => "badge bg-dark",
        "Completed" => "badge bg-secondary",
        _ => "badge bg-primary"
    };
}

<style>
    .module-card {
        transition: .2s ease;
        border-radius: 14px;
    }

    .module-card:hover {
        transform: translateY(-3px);
    }

    .module-card.disabled {
        opacity: .75;
    }
</style>
