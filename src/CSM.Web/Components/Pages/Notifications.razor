@page "/notifications"
@using CSM.Web.Models.Notifications
@inject CSM.Web.Services.INotificationApiService NotificationService
@inject NavigationManager Navigation

<PageTitle>Notifications | CSM</PageTitle>

<main class="notifications-page">
    <header class="notifications-header">
        <div>
            <div class="notifications-eyebrow">
                <i class="bi bi-bell" aria-hidden="true"></i>
                Updates &amp; alerts
            </div>
            <h1>Notifications</h1>
            <p>Stay up to date with activity across your workspace.</p>
        </div>

        <button class="notifications-refresh"
                type="button"
                @onclick="LoadAsync"
                disabled="@_loading"
                aria-label="Refresh notifications">
            <i class="bi bi-arrow-clockwise @(_loading ? "notifications-spin" : string.Empty)"
               aria-hidden="true"></i>
            <span>Refresh</span>
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <div class="notifications-alert" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>@_actionError</span>
            <button type="button"
                    class="notifications-alert-dismiss"
                    @onclick="() => _actionError = null"
                    aria-label="Dismiss error">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    }

    @if (_loading && _notifications.Count == 0)
    {
        <section class="notifications-state" aria-live="polite" aria-busy="true">
            <span class="notifications-loader" aria-hidden="true"></span>
            <h2>Loading notifications</h2>
            <p>Checking for your latest updates…</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="notifications-state notifications-state-error" role="alert">
            <span class="notifications-state-icon">
                <i class="bi bi-cloud-slash" aria-hidden="true"></i>
            </span>
            <h2>Notifications could not be loaded</h2>
            <p>@_error</p>
            <button class="notifications-primary-button" type="button" @onclick="LoadAsync">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                Try again
            </button>
        </section>
    }
    else
    {
        <section class="notification-summary" aria-label="Notification summary">
            <article class="summary-card">
                <span class="summary-icon summary-icon-total">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                </span>
                <div>
                    <span class="summary-label">Total updates</span>
                    <strong>@_notifications.Count</strong>
                </div>
            </article>
            <article class="summary-card">
                <span class="summary-icon summary-icon-unread">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                </span>
                <div>
                    <span class="summary-label">Unread</span>
                    <strong>@UnreadCount</strong>
                </div>
            </article>
            <article class="summary-card">
                <span class="summary-icon summary-icon-priority">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                </span>
                <div>
                    <span class="summary-label">Needs attention</span>
                    <strong>@PriorityCount</strong>
                </div>
            </article>
        </section>

        <section class="notifications-panel" aria-labelledby="notification-list-title">
            <div class="notifications-panel-header">
                <div>
                    <h2 id="notification-list-title">@(_activeFilter == "inbox" ? "Inbox" : "Notification history")</h2>
                    <p>@(_activeFilter == "inbox"
                           ? "Notifications move to History after you read them."
                           : "Read notifications stay here for future reference.")</p>
                </div>
                <div class="notification-filters" role="group" aria-label="Filter notifications">
                    <button type="button"
                            class="@FilterClass("inbox")"
                            aria-pressed="@(_activeFilter == "inbox")"
                            @onclick='() => SetFilter("inbox")'>
                        Inbox <span>@UnreadCount</span>
                    </button>
                    <button type="button"
                            class="@FilterClass("history")"
                            aria-pressed="@(_activeFilter == "history")"
                            @onclick='() => SetFilter("history")'>
                        History <span>@ReadCount</span>
                    </button>
                </div>
            </div>

            @if (!FilteredNotifications.Any())
            {
                <div class="notifications-state notifications-empty">
                    <span class="notifications-state-icon">
                        <i class="bi @(_activeFilter == "inbox" ? "bi-bell-slash" : "bi-archive")"
                           aria-hidden="true"></i>
                    </span>
                    <h2>@(_activeFilter == "inbox" ? "You’re all caught up" : "No notification history yet")</h2>
                    <p>@(_activeFilter == "inbox"
                           ? "Read notifications are saved in History."
                           : "Notifications you read will be saved here.")</p>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var notification in FilteredNotifications)
                    {
                        var link = GetLink(notification);
                        var isMarkingRead = _markingRead.Contains(notification.Id);

                        <article class="notification-item @(notification.IsRead ? "is-read" : "is-unread")">
                            <span class="notification-indicator" aria-hidden="true"></span>
                            <span class="notification-icon @GetSeverityTone(notification.Severity)">
                                <i class="bi @GetSeverityIcon(notification.Severity)" aria-hidden="true"></i>
                            </span>

                            <div class="notification-content">
                                <div class="notification-topline">
                                    <div class="notification-title-group">
                                        <h3>@notification.Title</h3>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="notification-unread-label">New</span>
                                        }
                                    </div>
                                    <span class="@GetSeverityClass(notification.Severity)">
                                        @notification.Severity
                                    </span>
                                </div>

                                <p class="notification-message">@notification.Message</p>

                                <div class="notification-footer">
                                    <time datetime="@notification.CreatedAtUtc.ToUniversalTime().ToString("O")">
                                        <i class="bi bi-clock" aria-hidden="true"></i>
                                        @notification.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                                    </time>
                                    @if (notification.IsRead && notification.ReadAtUtc is DateTime readAtUtc)
                                    {
                                        <span class="notification-read-time">
                                            Read @readAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")
                                        </span>
                                    }

                                    @if (link is not null || !notification.IsRead)
                                    {
                                        <div class="notification-actions">
                                            @if (link is not null)
                                            {
                                                <button class="notification-open-button"
                                                        type="button"
                                                        @onclick="() => OpenAsync(notification)">
                                                    Open
                                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                                </button>
                                            }

                                            @if (!notification.IsRead)
                                            {
                                                <button class="notification-read-button"
                                                        type="button"
                                                        disabled="@isMarkingRead"
                                                        @onclick="() => MarkAsReadAsync(notification.Id)">
                                                    @if (isMarkingRead)
                                                    {
                                                        <span class="notification-button-spinner" aria-hidden="true"></span>
                                                        <span>Marking…</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-check2" aria-hidden="true"></i>
                                                        <span>Mark as read</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    private List<NotificationResponse> _notifications = [];
    private readonly HashSet<Guid> _markingRead = [];
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private string _activeFilter = "inbox";

    private int UnreadCount => _notifications.Count(notification => !notification.IsRead);
    private int ReadCount => _notifications.Count(notification => notification.IsRead);

    private int PriorityCount => _notifications.Count(notification =>
        !notification.IsRead &&
        (string.Equals(notification.Severity, "Critical", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(notification.Severity, "Warning", StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<NotificationResponse> FilteredNotifications =>
        _notifications
            .OrderByDescending(notification => notification.CreatedAtUtc)
            .Where(notification => _activeFilter switch
            {
                "history" => notification.IsRead,
                _ => !notification.IsRead
            });

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = await NotificationService.GetAsync();
            _notifications = result.ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task MarkAsReadAsync(Guid notificationId)
    {
        _actionError = null;
        _markingRead.Add(notificationId);

        try
        {
            var updatedNotification = await NotificationService.MarkReadAsync(notificationId);
            var notification = _notifications.FirstOrDefault(item => item.Id == notificationId);

            if (notification is not null)
            {
                notification.IsRead = updatedNotification?.IsRead ?? true;
                notification.ReadAtUtc = updatedNotification?.ReadAtUtc ?? DateTime.UtcNow;
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _markingRead.Remove(notificationId);
        }
    }

    private static string? GetLink(NotificationResponse notification)
    {
        if (notification.SourceEntityId is not Guid id)
        {
            return null;
        }

        return notification.SourceEntityType switch
        {
            "Expense" => $"/finance/company/expenses/{id}",
            "LeaveRequest" => "/hr/leave",
            "Attendance" => "/hr/attendance",
            "MissedCheckIn" => "/hr/attendance",
            "Budget" => "/finance/company/budgets",
            _ => null
        };
    }

    private async Task OpenAsync(NotificationResponse notification)
    {
        var link = GetLink(notification);

        if (link is null)
        {
            return;
        }

        _actionError = null;

        if (!notification.IsRead)
        {
            try
            {
                var updatedNotification = await NotificationService.MarkReadAsync(notification.Id);
                notification.IsRead = updatedNotification?.IsRead ?? true;
                notification.ReadAtUtc = updatedNotification?.ReadAtUtc ?? DateTime.UtcNow;
            }
            catch (Exception ex)
            {
                _actionError = ex.Message;
                return;
            }
        }

        Navigation.NavigateTo(link);
    }

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
    }

    private string FilterClass(string filter) =>
        _activeFilter == filter ? "notification-filter active" : "notification-filter";

    private static string GetSeverityTone(string severity) =>
        severity.ToLowerInvariant() switch
        {
            "critical" => "severity-tone-critical",
            "warning" => "severity-tone-warning",
            "info" => "severity-tone-info",
            _ => "severity-tone-default"
        };

    private static string GetSeverityIcon(string severity) =>
        severity.ToLowerInvariant() switch
        {
            "critical" => "bi-exclamation-octagon",
            "warning" => "bi-exclamation-triangle",
            "info" => "bi-info-circle",
            _ => "bi-bell"
        };

    private static string GetSeverityClass(string severity) =>
        severity.ToLowerInvariant() switch
        {
            "critical" => "severity-badge severity-critical",
            "warning" => "severity-badge severity-warning",
            "info" => "severity-badge severity-info",
            _ => "severity-badge severity-default"
        };
}
