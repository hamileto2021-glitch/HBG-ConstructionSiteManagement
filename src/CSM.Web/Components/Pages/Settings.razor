@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Services
@using CSM.Web.Models.Security
@using CSM.Web.Models.UserPreferences
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using CSM.Web
@inject IStringLocalizer<SharedResource> L
@inject ILogger<Settings> Logger
@inject NavigationManager Navigation

@inject UserSessionsService SessionsService
@inject LoginHistoryService LoginHistory
@inject AuditHistoryService AuditService
@inject PersonalDataExportService PersonalDataExport
@inject PrivacyDataRequestService PrivacyDataRequests
@inject PasswordChangeService PasswordChanges
@inject CurrentUserProfileService CurrentUserProfileService
@inject OrganizationMembershipService OrganizationMembership
@inject MyProfileService MyProfileService

<PageTitle>Settings &amp; Privacy | CSM</PageTitle>

<div class="settings-page">

    <!-- Header -->
    <div class="settings-header">
        <div>
            <div class="settings-eyebrow">ACCOUNT CONTROL CENTER</div>
            <h1>Settings &amp; Privacy</h1>
            <p>Manage your preferences, account security, and privacy controls.</p>
        </div>

        <div class="settings-header-actions">
            <span class="settings-status">
                <span class="status-dot"></span>
                Account settings
            </span>
        </div>
    </div>

    <!-- Main layout -->
    <div class="settings-layout">

        <!-- Sidebar -->
        <nav class="settings-sidebar" aria-label="Settings categories">

            <div class="settings-sidebar-title">PREFERENCES</div>

            <button class="@TabClass("general")"
                    aria-current="@(_activeTab == "general" ? "page" : null)"
                    @onclick='() => SelectTab("general")'>
                <i class="bi bi-sliders2"></i>
                <span>General</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button class="@TabClass("appearance")"
                    aria-current="@(_activeTab == "appearance" ? "page" : null)"
                    @onclick='() => SelectTab("appearance")'>
                <i class="bi bi-palette"></i>
                <span>Appearance</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button class="@TabClass("notifications")"
                    aria-current="@(_activeTab == "notifications" ? "page" : null)"
                    @onclick='() => SelectTab("notifications")'>
                <i class="bi bi-bell"></i>
                <span>Notifications</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <div class="settings-sidebar-title mt-4">ACCOUNT &amp; SECURITY</div>

            <button class="@TabClass("account")"
                    aria-current="@(_activeTab == "account" ? "page" : null)"
                    @onclick='() => SelectTab("account")'>
                <i class="bi bi-person-circle"></i>
                <span>Account</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button class="@TabClass("security")"
                    aria-current="@(_activeTab == "security" ? "page" : null)"
                    @onclick='() => SelectTab("security")'>
                <i class="bi bi-shield-lock"></i>
                <span>Security</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button class="@TabClass("sessions")"
                    aria-current="@(_activeTab == "sessions" ? "page" : null)"
                    @onclick='() => SelectTab("sessions")'>
                <i class="bi bi-pc-display"></i>
                <span>Sessions &amp; Devices</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <div class="settings-sidebar-title mt-4">PRIVACY &amp; DATA</div>

            <button class="@TabClass("privacy")"
                    aria-current="@(_activeTab == "privacy" ? "page" : null)"
                    @onclick='() => SelectTab("privacy")'>
                <i class="bi bi-shield-check"></i>
                <span>Privacy Controls</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button class="@TabClass("data")"
                    aria-current="@(_activeTab == "data" ? "page" : null)"
                    @onclick='() => SelectTab("data")'>
                <i class="bi bi-database-lock"></i>
                <span>Data Management</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <div class="settings-sidebar-footer">
                <i class="bi bi-shield-check"></i>
                <div>
                    <strong>CSM Security</strong>
                    <p>Manage your account responsibly.</p>
                </div>
            </div>

        </nav>

        <!-- Content -->
        <main class="settings-content" aria-label="Settings panel">

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="settings-message @(_messageIsError ? "message-error" : "message-success")"
                     role="@(_messageIsError ? "alert" : "status")"
                     aria-live="@(_messageIsError ? "assertive" : "polite")">
                    <i class="bi @(_messageIsError ? "bi-exclamation-circle" : "bi-check-circle")" aria-hidden="true"></i>
                    @_message
                    <button type="button"
                            class="message-close"
                            aria-label="Dismiss message"
                            @onclick="ClearMessage">
                        &times;
                    </button>
                </div>
            }

            @if (_activeTab == "general")
            {
                <section>
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="bi bi-sliders2"></i>
                        </div>
                        <div>
                            <h2>@L["Settings.General.Title"]</h2>
                            <p>@L["Settings.General.Description"]</p>
                        </div>
                    </div>

                    <div class="settings-card">
                        <div class="settings-card-heading">
                            <h2>@L["Settings.General.WorkspaceTitle"]</h2>
                            <p>@L["Settings.General.WorkspaceDescription"]</p>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <h2>@L["Settings.General.CompactInterface"]</h2>
                                <p>@L["Settings.General.CompactInterfaceDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.General.CompactInterface"]"
                                       @bind="_compactMode"
                                       @bind:after="ApplyCompactModeAsync" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <h2>@L["Settings.General.ConfirmationPrompts"]</h2>
                                <p>@L["Settings.General.ConfirmationPromptsDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       @bind="_confirmActions"
                                       aria-label="@L["Settings.General.ConfirmationPrompts"]" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <h2>@L["Settings.General.RememberNavigation"]</h2>
                                <p>@L["Settings.General.RememberNavigationDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.General.RememberNavigation"]"
                                       @bind="_rememberNavigation" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-card">
                        <div class="settings-card-heading">
                            <h3>@L["Settings.Regional.Title"]</h3>
                            <p>@L["Settings.Regional.Description"]</p>
                        </div>

                        <div class="settings-form-grid">
                            <div class="settings-field">
                               <label for="language">@L["Settings.Regional.DisplayLanguage"]</label>
                               <select id="language" class="form-select" @bind="_language">
                                   <option value="en">@L["Settings.Language.English"]</option>
                                   <option value="am">@L["Settings.Language.Amharic"]</option>
                                   <option value="om">@L["Settings.Language.AfanOromo"]</option>
                               </select>
                               <small>@L["Settings.Regional.LanguageDescription"]</small>
                            </div>

                            <div class="settings-field">
                                <label for="dateFormat">@L["Settings.Regional.DateFormat"]</label>
                                <select id="dateFormat" class="form-select" @bind="_dateFormat">
                                    <option value="dd/MM/yyyy">DD/MM/YYYY</option>
                                    <option value="MM/dd/yyyy">MM/DD/YYYY</option>
                                    <option value="yyyy-MM-dd">YYYY-MM-DD</option>
                                </select>
                            </div>

                            <div class="settings-field">
                                <label for="timeFormat">@L["Settings.Regional.TimeFormat"]</label>
                                <select id="timeFormat" class="form-select" @bind="_timeFormat">
                                   <option value="24">@L["Settings.TimeFormat.24Hour"]</option>
                                   <option value="12">@L["Settings.TimeFormat.12Hour"]</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </section>
            }
            else if (_activeTab == "appearance")
            {
                <section>
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="bi bi-palette"></i>
                        </div>
                        <div>
                            <h2>@L["Settings.Appearance.Title"]</h2>
                            <p>@L["Settings.Appearance.Description"]</p>
                        </div>
                    </div>

                    <div class="settings-card">
                        <div class="settings-card-heading">
                            <h3>@L["Settings.Appearance.ThemeTitle"]</h3>
                            <p>@L["Settings.Appearance.ThemeDescription"]</p>
                        </div>

                        <div class="theme-grid">
                            <button type="button"
                                    class="@($"theme-option {(_theme == "light" ? "theme-selected" : "")}")"
                                    aria-pressed="@(_theme == "light")"
                                    @onclick='() => SetThemeAsync("light")'>
                                <div class="theme-preview theme-light">
                                    <div class="theme-preview-sidebar"></div>
                                    <div class="theme-preview-content">
                                        <span></span><span></span><span></span>
                                    </div>
                                </div>
                               <strong>@L["Settings.Theme.Light"]</strong>
                               <small>@L["Settings.Theme.LightDescription"]</small>
                            </button>

                            <button type="button"
                                    class="@($"theme-option {(_theme == "dark" ? "theme-selected" : "")}")"
                                    aria-pressed="@(_theme == "dark")"
                                    @onclick='() => SetThemeAsync("dark")'>
                                <div class="theme-preview theme-dark">
                                    <div class="theme-preview-sidebar"></div>
                                    <div class="theme-preview-content">
                                        <span></span><span></span><span></span>
                                    </div>
                                </div>
                               <strong>@L["Settings.Theme.Dark"]</strong>
                               <small>@L["Settings.Theme.DarkDescription"]</small>
                            </button>

                            <button type="button"
                                    class="@($"theme-option {(_theme == "system" ? "theme-selected" : "")}")"
                                    aria-pressed="@(_theme == "system")"
                                    @onclick='() => SetThemeAsync("system")'>
                                <div class="theme-preview theme-system">
                                    <div class="theme-preview-sidebar"></div>
                                    <div class="theme-preview-content">
                                        <span></span><span></span><span></span>
                                    </div>
                                </div>
                                <strong>@L["Settings.Theme.System"]</strong>
                                <small>@L["Settings.Theme.SystemDescription"]</small>
                            </button>
                        </div>

                        <div class="setting-row mt-4">
                            <div class="setting-description">
                                <strong>@L["Settings.Appearance.CompactInterface"]</strong>
                                <p>@L["Settings.Appearance.CompactInterfaceDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Appearance.CompactInterface"]"
                                       @bind="_compactMode"
                                       @bind:after="ApplyCompactModeAsync" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-info">
                        <i class="bi bi-info-circle"></i>
                        @L["Settings.Appearance.ThemeInfo"]
                        @L["Settings.Appearance.ThemeInfoDetails"]
                    </div>
                </section>
            }
            else if (_activeTab == "notifications")
            {
                <section>
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="bi bi-bell"></i>
                        </div>
                        <div>
                            <h2>@L["Settings.Notifications.Title"]</h2>
                            <p>@L["Settings.Notifications.Description"]</p>
                        </div>
                    </div>

                    <div class="settings-card">
                        <div class="settings-card-heading">
                            <h3>@L["Settings.Notifications.OperationalTitle"]</h3>
                            <p>@L["Settings.Notifications.OperationalDescription"]</p>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.ProjectUpdates"]</strong>
                                <p>@L["Settings.Notifications.ProjectUpdatesDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.ProjectUpdates"]"
                                       @bind="_projectNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.ApprovalRequests"]</strong>
                                <p>@L["Settings.Notifications.ApprovalRequestsDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.ApprovalRequests"]"
                                       @bind="_approvalNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.InventoryAlerts"]</strong>
                                <p>@L["Settings.Notifications.InventoryAlertsDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.InventoryAlerts"]"
                                       @bind="_inventoryNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.HrAttendance"]</strong>
                                <p>@L["Settings.Notifications.HrAttendanceDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.HrAttendance"]"
                                       @bind="_hrNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.FinancialAlerts"]</strong>
                                <p>@L["Settings.Notifications.FinancialAlertsDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.FinancialAlerts"]"
                                       @bind="_financialNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.SecurityAlerts"]</strong>
                                <p>@L["Settings.Notifications.SecurityAlertsDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.SecurityAlerts"]"
                                       @bind="_securityAlerts" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-card">
                        <div class="settings-card-heading">
                            <h3>@L["Settings.Notifications.DeliveryChannelsTitle"]</h3>
                            <p>@L["Settings.Notifications.DeliveryChannelsDescription"]</p>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.InApp"]</strong>
                                <p>@L["Settings.Notifications.InAppDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.InApp"]"
                                       @bind="_inAppNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.Email"]</strong>
                                <p>@L["Settings.Notifications.EmailDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.Email"]"
                                       @bind="_emailNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>@L["Settings.Notifications.Push"]</strong>
                                <p>@L["Settings.Notifications.PushDescription"]</p>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox"
                                       aria-label="@L["Settings.Notifications.Push"]"
                                       @bind="_pushNotifications" />
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-info">
                        <i class="bi bi-info-circle"></i>
                        @L["Settings.Notifications.Info"]
                    </div>
                </section>
            }
            else if (_activeTab == "account")
            {
                <section>
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div>
                            <h2>Account</h2>
                            <p>Review account-related options and profile management.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <button class="btn btn-outline-primary"
                                @onclick="LoadCurrentUserProfileAsync"
                                disabled="@_currentUserProfileLoading">
                            @(_currentUserProfileLoading
                                ? "Loading account..."
                                : _currentUserProfileLoaded
                                    ? "Refresh account information"
                                    : "Load account information")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_currentUserProfileError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_currentUserProfileError
                        </div>
                    }

                    @if (_currentUserProfile is not null)
                    {
                        <dl class="row">
                            <dt class="col-sm-4">User ID</dt>
                            <dd class="col-sm-8">@(_currentUserProfile.UserId ?? "Not available")</dd>

                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@(_currentUserProfile.Name ?? "Not available")</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@(_currentUserProfile.Email ?? "Not available")</dd>

                            <dt class="col-sm-4">Company ID</dt>
                            <dd class="col-sm-8">@(_currentUserProfile.CompanyId ?? "Not available")</dd>

                            <dt class="col-sm-4">Employee ID</dt>
                            <dd class="col-sm-8">@(_currentUserProfile.EmployeeId ?? "Not available")</dd>

                            <dt class="col-sm-4">Roles</dt>
                            <dd class="col-sm-8">
                                @( _currentUserProfile.Roles.Count > 0
                                    ? string.Join(", ", _currentUserProfile.Roles)
                                    : "No roles returned")
                            </dd>

                            <dt class="col-sm-4">Active site access</dt>
                            <dd class="col-sm-8">
                                @(_currentUserProfile.HasActiveSiteAccess ? "Yes" : "No")
                            </dd>
                        </dl>
                    }

                    <div class="settings-card">
                        <div class="settings-card-heading">
                            <h3>Account management</h3>
                            <p>Manage your account through the application's authorized workflows.</p>
                        </div>


<div class="setting-row">
    <div class="setting-description">
        <strong>Profile management</strong>
        <p>Update your name, phone number, and job title.</p>
    </div>
    <button class="btn btn-outline-primary"
            @onclick="LoadMyProfileForEditAsync"
            disabled="@_myProfileLoading">
        @(_myProfileLoading
            ? "Loading profile..."
            : _myProfileLoaded
                ? "Refresh profile"
                : "Edit profile")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_myProfileError))
{
    <div class="alert alert-danger mt-3" role="alert">
        @_myProfileError
    </div>
}

@if (!string.IsNullOrWhiteSpace(_myProfileSuccess))
{
    <div class="alert alert-success mt-3" role="status">
        @_myProfileSuccess
    </div>
}

@if (_myProfileLoaded)
{
    <EditForm Model="_myProfileForm" OnValidSubmit="SaveMyProfileAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label" for="profileFirstName">
                    First name
                </label>
                <InputText id="profileFirstName"
                           class="form-control"
                           @bind-Value="_myProfileForm.FirstName" />
                <ValidationMessage For="@(() => _myProfileForm.FirstName)" />
            </div>

            <div class="col-md-6">
                <label class="form-label" for="profileLastName">
                    Last name
                </label>
                <InputText id="profileLastName"
                           class="form-control"
                           @bind-Value="_myProfileForm.LastName" />
                <ValidationMessage For="@(() => _myProfileForm.LastName)" />
            </div>

            <div class="col-md-6">
                <label class="form-label" for="profilePhoneNumber">
                    Phone number
                </label>
                <InputText id="profilePhoneNumber"
                           class="form-control"
                           @bind-Value="_myProfileForm.PhoneNumber" />
                <ValidationMessage For="@(() => _myProfileForm.PhoneNumber)" />
            </div>

            <div class="col-md-6">
                <label class="form-label" for="profileJobTitle">
                    Job title
                </label>
                <InputText id="profileJobTitle"
                           class="form-control"
                           @bind-Value="_myProfileForm.JobTitle" />
                <ValidationMessage For="@(() => _myProfileForm.JobTitle)" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_myProfileSaving">
                @(_myProfileSaving ? "Saving..." : "Save profile")
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="CancelMyProfileEdit"
                    disabled="@_myProfileSaving">
                Cancel
            </button>
        </div>
    </EditForm>
}


                        <div class="setting-row">
                            <div class="setting-description">
                                <strong>Organization membership</strong>
                                <p>Review your company and assigned site access.</p>
                            </div>
                            <button class="btn btn-outline-primary"
                                    @onclick="LoadOrganizationMembershipAsync"
                                    disabled="@_organizationMembershipLoading">
                                @(_organizationMembershipLoading
                                    ? "Loading membership..."
                                    : _organizationMembershipLoaded
                                        ? "Refresh membership"
                                        : "View membership")
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_organizationMembershipError))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_organizationMembershipError
                            </div>
                        }

                        @if (_organizationMembershipLoaded)
                        {
                            @if (_organizationMemberships.Count == 0)
                            {
                                <p class="text-muted">
                                    No active site assignments were found for this account.
                                </p>
                            }
                            else
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-striped align-middle">
                                        <thead>
                                            <tr>
                                                <th>Site code</th>
                                                <th>Site name</th>
                                                <th>Location</th>
                                                <th>Status</th>
                                                <th>Assignment</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var membership in _organizationMemberships)
                                            {
                                                <tr>
                                                    <td>@(membership.SiteCode ?? "—")</td>
                                                    <td>@(membership.SiteName ?? "—")</td>
                                                    <td>
                                                        @string.Join(", ", new[]
                                                        {
                                                            membership.Address,
                                                            membership.City,
                                                            membership.Region,
                                                            membership.Country
                                                        }.Where(value =>
                                                            !string.IsNullOrWhiteSpace(value)))
                                                    </td>
                                                    <td>@(membership.SiteStatus ?? "Unknown")</td>
                                                    <td>
                                                        @(membership.IsDefault ? "Default site" : "Assigned site")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </section>
            }
            else if (_activeTab == "security")
            {
                <section>
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div>
                            <h2>Security</h2>
                            <p>Protect your CSM account and authentication credentials.</p>
                        </div>
                    </div>

