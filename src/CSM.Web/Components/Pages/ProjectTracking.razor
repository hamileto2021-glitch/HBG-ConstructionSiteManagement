@page "/project-tracking"
@rendermode InteractiveServer

@inject NavigationManager Navigation

<PageTitle>Project Tracking</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="mb-1">Project Tracking</h2>
        <p class="text-muted">
            Monitor construction sites, projects, daily progress and milestones.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <h5>Construction Sites</h5>
                    <p class="text-muted">
                        Manage sites, GPS geofences and operational status.
                    </p>
                </div>
                <div class="card-footer bg-white border-0">
                    <button class="btn btn-primary w-100"
                            @onclick='() => Navigation.NavigateTo("/sites-management")'>
                        Open
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>