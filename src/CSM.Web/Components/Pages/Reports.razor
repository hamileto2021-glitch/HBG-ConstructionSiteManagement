@page "/reports"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net
@using System.Text.Json
@using CSM.Web.Models.Reporting
@using CSM.Web.Models.Sites
@using CSM.Web.Models.Projects
@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Equipment
@using CSM.Web.Models.HRM
@using CSM.Web.Models.Compliance
@using CSM.Web.Services

@inject IReportingService ReportingService
@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject IProcurementService ProcurementService
@inject IEquipmentService EquipmentService
@inject IEmployeeService EmployeeService
@inject IAttendanceService AttendanceService
@inject ITimesheetService TimesheetService
@inject ILeaveService LeaveService
@inject IPayrollService PayrollService
@inject IComplianceService ComplianceService
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Reports & Analytics</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">Reports & Analytics</h2>
            <p class="text-muted mb-0">
                @ScopeIntro
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="RefreshAsync"
                disabled="@_busy">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
        </button>
    </div>

    <!-- Scope. Always visible, so an error never leaves the user stuck. -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Report Scope</label>

                    <select class="form-select"
                            @bind="_scope"
                            @bind:after="ScopeChangedAsync">
                        <option value="All">
                            @(_canViewCompanyWideFinancials
                                ? "Company + all sites"
                                : "Assigned sites only")
                        </option>
                        @if (_canViewCompanyWideFinancials)
                        {
                            <option value="Company">Company level (not tied to a site)</option>
                        }
                        <option value="Site">Site</option>
                    </select>
                </div>

                @if (_scope == "Site")
                {
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">
                            Construction Site
                        </label>

                        <select class="form-select"
                                @bind="_selectedSiteId"
                                @bind:after="SiteChangedAsync">
                            <option value="">-- Select Site --</option>

                            @foreach (var site in VisibleSites)
                            {
                                <option value="@site.Id">
                                    @site.Name (@site.SiteCode)
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="col-md-3">
                    <div class="text-muted small">Current Scope</div>
                    <div class="fw-semibold">@CurrentScopeLabel</div>
                </div>

            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_scopeError))
    {
        <div class="alert alert-danger" role="alert">@_scopeError</div>
    }
    else if (!string.IsNullOrWhiteSpace(_sitesError))
    {
        <div class="alert alert-warning">@_sitesError</div>
    }

    @if (string.IsNullOrWhiteSpace(_scopeError) && _busy)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"></div>
            <div class="mt-2">Loading reports...</div>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(_scopeError) &&
             _scope == "Site" &&
             !HasSelectedSite)
    {
        <div class="alert alert-info">
            Select a construction site to see its reports.
        </div>
    }
    else if (string.IsNullOrWhiteSpace(_scopeError))
    {
        <!-- Executive report (sites and projects only exist per site, so it is not shown for company level) -->
        @if (_scope != "Company")
        {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Executive Report
                        </h5>
                        <small>
                            @ExecutiveSubtitle
                        </small>
                    </div>

                    <span class="badge bg-light text-dark">
                        @CurrentScopeLabel
                    </span>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_executiveError))
                {
                    <div class="alert alert-danger mb-0">@_executiveError</div>
                }
                else if (Executive is not null)
                {
                    <div class="row g-3">

                        @Tile("Construction Sites",
                            SitesText(Executive),
                            col: "col-md-6 col-xl-3")

                        @Tile("Projects",
                            Executive.TotalProjects.ToString("N0"),
                            col: "col-md-6 col-xl-3")

                        @Tile("Contract Value",
                            Money(Executive.TotalContractValue),
                            hint: "All projects",
                            col: "col-md-6 col-xl-3")

                        @Tile("Budget",
                            Money(Executive.TotalBudget),
                            hint: "Approved, active and closed budgets",
                            col: "col-md-6 col-xl-3")

                        @UsedTile(Executive.TotalBudget,
                            Executive.TotalExpenses,
                            "col-md-6 col-xl-3")

                        @Tile("Invoiced to Clients",
                            Money(Executive.TotalInvoices),
                            col: "col-md-6 col-xl-3")

                        @Tile("Collected",
                            Money(Executive.TotalCompletedPayments),
                            css: "text-success",
                            hint: "Completed incoming payments",
                            col: "col-md-6 col-xl-3")

                        @Tile("Outstanding Invoices",
                            Money(Executive.OutstandingInvoices),
                            css: "text-warning",
                            hint: "Unpaid balance of client invoices",
                            col: "col-md-6 col-xl-3")

                    </div>

                    <hr class="my-4" />

                    <div class="row g-4">

                        <div class="col-lg-6">
                            <h6 class="fw-bold mb-3">Sites by Status</h6>

                            @if (Executive.SitesByStatus.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Status</th>
                                                <th class="text-end">Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Executive.SitesByStatus)
                                            {
                                                <tr>
                                                    <td>@item.Key</td>
                                                    <td class="text-end">@item.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    No site status data available.
                                </div>
                            }
                        </div>

                        <div class="col-lg-6">
                            <h6 class="fw-bold mb-3">Projects by Status</h6>

                            @if (Executive.ProjectsByStatus.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Status</th>
                                                <th class="text-end">Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Executive.ProjectsByStatus)
                                            {
                                                <tr>
                                                    <td>@item.Key</td>
                                                    <td class="text-end">@item.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    No project status data available.
                                </div>
                            }
                        </div>

                    </div>
                }

            </div>
        </div>

        }

        <!-- Financial report -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-cash-stack me-2"></i>
                            Financial Report
                        </h5>
                        <small>
                            @FinancialSubtitle
                        </small>
                    </div>

                    <span class="badge bg-light text-dark">
                        @CurrentScopeLabel
                    </span>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_financialError))
                {
                    <div class="alert alert-danger mb-0">@_financialError</div>
                }
                else if (Summary is not null)
                {
                    <h6 class="fw-bold mb-1">1. Budget</h6>
                    <div class="text-muted small mb-3">
                        Remaining = budget - expenses. Expenses = approved and paid expense
                        records + paid payroll + petty cash out.
                    </div>

                    <div class="row g-3 mb-4">

                        @Tile("Budget",
                            Money(Summary.TotalBudget),
                            hint: Split(f => f.TotalBudget, "Approved, active and closed budgets"),
                            col: "col-md-6 col-xl-3")

                        @Tile("Expenses",
                            Money(Summary.TotalExpenses),
                            css: "text-danger",
                            hint: "Expense records + paid payroll + petty cash out",
                            col: "col-md-6 col-xl-3")

                        @Tile("Remaining",
                            Money(Summary.RemainingBudget),
                            css: BalanceClass(Summary.RemainingBudget),
                            hint: "Negative means over budget",
                            col: "col-md-6 col-xl-3")

                        @UsedTile(Summary.TotalBudget, Summary.TotalExpenses, "col-md-6 col-xl-3")

                    </div>

                    <div class="small text-muted mb-4">
                        <strong>Expenses</strong> @Money(Summary.TotalExpenses) =
                        expense records @Money(Summary.ExpenseRecords) +
                        paid payroll @Money(Summary.PayrollPaid) +
                        petty cash out @Money(Summary.PettyCashOut)
                    </div>

                    <h6 class="fw-bold mb-1">2. Invoices</h6>
                    <div class="text-muted small mb-3">
                        Worked out invoice by invoice: total minus the completed payments on it.
                    </div>

                    <div class="row g-3 mb-4">

                        @Tile("Invoiced to Clients",
                            Money(Summary.TotalInvoiced),
                            hint: "Issued client invoices",
                            col: "col-md-6 col-xl-4")

                        @Tile("Clients Owe Us",
                            Money(Summary.OutstandingReceivables),
                            css: "text-warning",
                            hint: "Unpaid balance of client invoices",
                            col: "col-md-6 col-xl-4")

                        @Tile("We Owe Vendors",
                            Money(Summary.OutstandingPayables),
                            css: "text-warning",
                            hint: "Unpaid balance of vendor bills",
                            col: "col-md-6 col-xl-4")

                    </div>

                    <h6 class="fw-bold mb-1">3. Petty Cash</h6>
                    <div class="text-muted small mb-3">
                        Opening balance + cash in - cash out = balance
                        (@Summary.ActivePettyCashAccounts.ToString("N0") active accounts).
                        Top-ups move money between your own accounts.
                    </div>

                    <div class="row g-3">

                        @Tile("Opening Balance",
                            Money(Summary.PettyCashOpeningBalance),
                            hint: "Money the accounts were opened with",
                            col: "col-md-6 col-xl-3")

                        @Tile("+ Cash In",
                            Money(Summary.PettyCashIn),
                            css: "text-success",
                            hint: "Top-ups recorded",
                            col: "col-md-6 col-xl-3")

                        @Tile("- Cash Out",
                            Money(Summary.PettyCashOut),
                            css: "text-danger",
                            hint: "Spending recorded",
                            col: "col-md-6 col-xl-3")

                        @Tile("= Balance",
                            Money(Summary.PettyCashBalance),
                            hint: "What the accounts hold now",
                            col: "col-md-6 col-xl-3")

                    </div>

                    @if (HasPettyCashGap(Summary))
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <strong>Petty cash does not add up.</strong>
                            @Money(-PettyCashGap(Summary)) left an account without a cash out
                            transaction, for example a balance changed directly.
                        </div>
                    }

                    <details class="mt-4">
                        <summary class="fw-semibold">How these numbers are calculated</summary>
                        <ul class="small mt-2 mb-0">
                            <li><strong>Budget</strong>: approved, active and closed budgets.</li>
                            <li><strong>Expenses</strong> = approved and paid expense records (including tax) + paid payroll (completed payments linked to a payroll record) + petty cash out. Payments on vendor bills and other payments are not expenses. Draft, submitted, rejected and cancelled expenses, and pending payments, are not counted.</li>
                            <li><strong>Counted twice</strong>: payroll and petty cash are not linked to expense records, so a cost entered as an expense and also as payroll or petty cash is counted twice.</li>
                            <li><strong>Invoices</strong>: issued invoices only. For each one, the unpaid balance is its total minus the completed payments on it (never below zero); the balances are then added up.</li>
                            <li><strong>Petty cash</strong>: the opening balance is what an account was opened with, worked out as balance - cash in + cash out.</li>
                            <li><strong>Where a record belongs</strong>: a payment belongs to its invoice's site, or to its own site when it has no invoice. Company level means records with no site.</li>
                        </ul>
                    </details>
                }

            </div>
        </div>

        <!-- Breakdown is limited to the company-wide or assigned-site scope. -->
        @if (_scope == "All" && _all is not null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">
                                <i class="bi bi-bar-chart-line me-2"></i>
                                Breakdown by Site
                            </h5>
                            <small>
                                @if (_canViewCompanyWideFinancials)
                                {
                                    <text>Head office and each construction site. The total row is the company-wide figure above.</text>
                                }
                                else
                                {
                                    <text>Only sites assigned to you. The total row includes those sites only.</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Site</th>
                                    <th>Code</th>
                                    <th class="text-end">Budget</th>
                                    <th class="text-end">Expenses</th>
                                    <th class="text-end">Used</th>
                                    <th class="text-end">Invoiced</th>
                                    <th class="text-end">Clients Owe</th>
                                    <th class="text-end">We Owe</th>
                                    <th class="text-end">Petty Cash</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var row in BreakdownRows)
                                {
                                    @DataRow(row)
                                }
                            </tbody>

                            <tfoot>
                                @DataRow(TotalRow, bold: true)
                            </tfoot>
                        </table>
                    </div>

                    @if (HasOtherRow)
                    {
                        <div class="text-muted small">
                            "Other" is activity recorded against sites that no
                            longer exist. It is included in the total.
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Operational report modules -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Additional Management Reports</h5>
            </div>

            <div class="card-body">
                @if (_operationalBusy)
                {
                    <div class="text-muted small mb-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading scoped report summaries…</div>
                }
                @if (!string.IsNullOrWhiteSpace(_operationalError))
                {
                    <div class="alert alert-warning">Some operational summaries could not be loaded: @_operationalError</div>
                }
                <div class="row g-3">

                    @if (CanProjectProgress) { @ProjectProgressReport() }
                    @if (CanSiteOperations) { @SiteOperationsReport() }
                    @if (CanHrReport) { @HrReport() }
                    @if (CanProcurementReport) { @ProcurementReport() }
                    @if (CanSafetyReport) { @SafetyReport() }

                </div>
            </div>
        </div>
    }

</div>

@code {

    // Company scope data (kept while the user looks at a site).
    private ExecutiveDashboardResponse? _allExecutive;
    private AllFinancialSummaryResponse? _all;
    private FinancialSummaryResponse? _companyLevelSummary;

    // Site scope data.
    private ExecutiveDashboardResponse? _siteExecutive;
    private FinancialSummaryResponse? _siteSummary;

    private List<SiteResponse> _sites = [];

    private string _scope = "All";
    private string _selectedSiteId = string.Empty;

    private bool _busy = true;
    private bool _userScopeLoaded;
    private bool _canViewCompanyWideFinancials;
    private bool _hasActiveSiteAccess;
    private bool _operationalBusy;
    private string? _operationalError;
    private HashSet<string> _permissions = new(StringComparer.OrdinalIgnoreCase);

    private bool CanProjectProgress => _permissions.Contains("Projects_View");
    private bool CanSiteOperations => CanProjectProgress ||
        _permissions.Contains("Procurement_Inventory_View") ||
        _permissions.Contains("Equipment_View");
    private bool CanHrReport => _permissions.Overlaps(new[]
    {
        "HRM_Employee_View", "HRM_Attendance_View", "HRM_Timesheet_View",
        "HRM_Leave_View", "HRM_Payroll_View"
    });
    private bool CanProcurementReport => _permissions.Overlaps(new[]
    {
        "Procurement_MaterialRequest_View", "Procurement_PurchaseOrder_View",
        "Procurement_Inventory_View"
    });
    private bool CanSafetyReport => _permissions.Contains("Compliance_View");

    private List<ProjectSummary> _projects = [];
    private Dictionary<Guid, List<ProjectMilestone>> _milestones = [];
    private Dictionary<Guid, DailyProgressLogResponse> _latestProgress = [];
    private List<MaterialRequestResponse> _materialRequests = [];
    private List<PurchaseOrderResponse> _purchaseOrders = [];
    private List<GoodsReceiptResponse> _goodsReceipts = [];
    private List<StockItemResponse> _stockItems = [];
    private List<EquipmentAssignmentResponse> _equipmentAssignments = [];
    private List<EmployeeResponse> _employees = [];
    private List<AttendanceResponse> _attendance = [];
    private List<TimesheetResponse> _timesheets = [];
    private List<LeaveResponse> _leave = [];
    private List<PayrollResponse> _payroll = [];
    private List<SafetyIncidentResponse> _incidents = [];
    private List<JsonElement> _inspections = [];
    private List<JsonElement> _permits = [];

    // Each section reports its own problem, so one failure never blanks
    // the page or hides the selectors.
    private string? _scopeError;
    private string? _sitesError;
    private string? _executiveError;
    private string? _financialError;

    // What the two main sections show, for the current scope. For the company
    // scope this is the company-wide total (head office + all sites), not the
    // head-office-only record set.
    // "All"     company + every site (the combined total)
    // "Company" company-level records only, not tied to any site
    // "Site"    one construction site
    private ExecutiveDashboardResponse? Executive
        => _scope == "All" ? _allExecutive
         : _scope == "Site" ? _siteExecutive
         : null;

    private FinancialSummaryResponse? Summary
        => _scope == "All" ? _all?.Total
         : _scope == "Site" ? _siteSummary
         : _companyLevelSummary;

    private bool HasSelectedSite => Guid.TryParse(_selectedSiteId, out _);

    // Only sites the user can open: the reporting service already limits the
    // breakdown to those.
    private List<SiteResponse> VisibleSites
    {
        get
        {
            if (_all is null)
            {
                return _sites;
            }

            var ids = _all.Sites
                .Select(s => s.SiteId)
                .ToHashSet();

            return _sites
                .Where(s => ids.Contains(s.Id))
                .ToList();
        }
    }

    private string CurrentScopeLabel
        => _scope == "All"
            ? _canViewCompanyWideFinancials
                ? "Company + all sites"
                : "Assigned sites"
         : _scope == "Company" ? "Company level"
         : _sites.FirstOrDefault(x => x.Id.ToString() == _selectedSiteId)?.Name
           ?? "Select a construction site";

    private string ScopeIntro
        => _scope == "All"
            ? _canViewCompanyWideFinancials
                ? "Company-wide management reports and financial analytics."
                : "Management reports and financial analytics for sites assigned to you."
         : _scope == "Company" ? "Company-level financial records that are not tied to a construction site."
         : $"{CurrentScopeLabel} management reports and financial analytics.";

    private string ExecutiveSubtitle
        => _scope == "All"
            ? _canViewCompanyWideFinancials
                ? "Company-wide management overview"
                : "Management overview for your assigned sites"
            : $"{CurrentScopeLabel} management overview";

    private string FinancialSubtitle
        => _scope == "All"
            ? _canViewCompanyWideFinancials
                ? "Company-wide financial position (company level and all sites)"
                : "Financial position for your assigned sites"
         : _scope == "Company" ? "Budgets, expenses and payments not tied to a construction site"
         : $"{CurrentScopeLabel} financial position";

    protected override Task OnInitializedAsync()
        => LoadInitialDataAsync();

    private async Task LoadInitialDataAsync()
    {
        _busy = true;
        _scopeError = null;

        try
        {
            _permissions = (await AuthService.GetPermissionsAsync())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            var userScope = await AuthService.GetCurrentUserScopeAsync();
            _hasActiveSiteAccess = userScope.HasActiveSiteAccess;
            var isSuperAdmin = userScope.Roles.Contains(
                "SuperAdmin",
                StringComparer.OrdinalIgnoreCase);
            var isAccountant = userScope.Roles.Contains(
                "Accountant",
                StringComparer.OrdinalIgnoreCase);

            _canViewCompanyWideFinancials =
                isSuperAdmin ||
                (isAccountant && !userScope.HasActiveSiteAccess);
            _userScopeLoaded = true;
        }
        catch (Exception ex)
        {
            _scopeError = $"Failed to verify report access. {FriendlyError(ex)}";
            _busy = false;
            return;
        }

        try
        {
            _sites = await ProjectService.GetSitesAsync();
        }
        catch (Exception ex)
        {
            _sitesError = $"Failed to load construction sites. {FriendlyError(ex)}";
        }

        await LoadAllAsync();
        await LoadOperationalReportsAsync();
    }

    private async Task ScopeChangedAsync()
    {
        ClearErrors();

        if (_scope == "Company" && !_canViewCompanyWideFinancials)
        {
            _scope = "All";
            return;
        }

        if (_scope == "Site")
        {
            _siteExecutive = null;
            _siteSummary = null;
            _projects.Clear();
            _milestones.Clear();
            _latestProgress.Clear();
            return;
        }

        _selectedSiteId = string.Empty;

        if (_scope == "All")
        {
            if (_allExecutive is null && _all is null)
            {
                await LoadAllAsync();
            }
        }
        else if (_companyLevelSummary is null)
        {
            await LoadCompanyLevelAsync();
        }

        await LoadOperationalReportsAsync();
    }

    private async Task SiteChangedAsync()
    {
        ClearErrors();

        if (!Guid.TryParse(_selectedSiteId, out var siteId))
        {
            _siteExecutive = null;
            _siteSummary = null;
            _projects.Clear();
            _milestones.Clear();
            _latestProgress.Clear();
            return;
        }

        await LoadSiteAsync(siteId);
        await LoadOperationalReportsAsync();
    }

    private async Task RefreshAsync()
    {
        if (!_userScopeLoaded)
        {
            await LoadInitialDataAsync();
            return;
        }

        if (_scope == "Site" && Guid.TryParse(_selectedSiteId, out var siteId))
        {
            await LoadSiteAsync(siteId);
        }
        else if (_scope == "Company")
        {
            await LoadCompanyLevelAsync();
        }
        else
        {
            await LoadAllAsync();
        }
        await LoadOperationalReportsAsync();
    }

    private async Task LoadCompanyLevelAsync()
    {
        _busy = true;
        ClearErrors();

        _companyLevelSummary = null;

        try
        {
            _companyLevelSummary = await ReportingService.GetFinancialSummaryAsync();
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _financialError =
                "Company-level figures are only visible to roles with company-wide access.";
        }
        catch (Exception ex)
        {
            _financialError = FriendlyError(ex);
        }

        _busy = false;
    }

    private async Task LoadAllAsync()
    {
        _busy = true;
        ClearErrors();

        _allExecutive = null;
        _all = null;

        try
        {
            _allExecutive = await ReportingService.GetExecutiveDashboardAsync();
        }
        catch (Exception ex)
        {
            _executiveError = FriendlyError(ex);
        }

        // One call gives head office, every site and the company total.
        try
        {
            _all = await ReportingService.GetAllFinancialSummariesAsync();
        }
        catch (Exception ex)
        {
            _financialError = FriendlyError(ex);
        }

        _busy = false;
    }

    private async Task LoadSiteAsync(Guid siteId)
    {
        _busy = true;
        ClearErrors();

        _siteExecutive = null;
        _siteSummary = null;

        try
        {
            _siteExecutive = await ReportingService.GetSiteExecutiveDashboardAsync(siteId);
        }
        catch (Exception ex)
        {
            _executiveError = FriendlyError(ex);
        }

        try
        {
            _siteSummary = await ReportingService.GetSiteFinancialSummaryAsync(siteId);
        }
        catch (Exception ex)
        {
            _financialError = FriendlyError(ex);
        }

        _busy = false;
    }

    private void ClearErrors()
    {
        _executiveError = null;
        _financialError = null;
    }

    private async Task LoadOperationalReportsAsync()
    {
        if (_scope == "Company" || (_scope == "Site" && !HasSelectedSite)) return;

        _operationalBusy = true;
        _operationalError = null;
        var siteId = _scope == "Site" && Guid.TryParse(_selectedSiteId, out var parsed)
            ? parsed : (Guid?)null;
        bool InScope(Guid id) => !siteId.HasValue || id == siteId.Value;

        try
        {
            if (CanProjectProgress)
            {
                _projects = (await ProjectService.GetProjectsAsync())
                    .Where(p => InScope(p.ConstructionSiteId)).ToList();
                var milestoneTasks = _projects.Select(async p => (p.Id, Items: await ProjectService.GetProjectMilestonesAsync(p.Id)));
                foreach (var result in await Task.WhenAll(milestoneTasks)) _milestones[result.Id] = result.Items;
                if (CanSiteOperations)
                {
                    var progressTasks = _projects.Select(async p => (p.Id, Items: await ProjectService.GetDailyProgressLogsAsync(p.Id)));
                    foreach (var result in await Task.WhenAll(progressTasks))
                        if (result.Items.Count > 0) _latestProgress[result.Id] = result.Items.OrderByDescending(x => x.LogDate).First();
                }
            }

            if (CanSiteOperations && _permissions.Contains("Procurement_Inventory_View"))
                _stockItems = (await ProcurementService.GetStockItemsAsync()).Where(x => InScope(x.ConstructionSiteId)).ToList();
            if (_permissions.Contains("Equipment_View"))
                _equipmentAssignments = (await EquipmentService.GetAssignmentsAsync()).Where(x => InScope(x.ConstructionSiteId)).ToList();

            if (CanProcurementReport)
            {
                var calls = new List<Task>();
                if (_permissions.Contains("Procurement_MaterialRequest_View")) calls.Add(LoadRequestsAsync(InScope));
                if (_permissions.Contains("Procurement_PurchaseOrder_View")) calls.Add(LoadOrdersAsync(InScope));
                if (_permissions.Contains("Procurement_Inventory_View"))
                {
                    if (_stockItems.Count == 0) _stockItems = (await ProcurementService.GetStockItemsAsync()).Where(x => InScope(x.ConstructionSiteId)).ToList();
                    calls.Add(LoadReceiptsAsync(InScope));
                }
                await Task.WhenAll(calls);
            }

            if (CanHrReport)
            {
                var tasks = new List<Task>();
                if (_permissions.Contains("HRM_Employee_View")) tasks.Add(LoadEmployeesAsync());
                if (_permissions.Contains("HRM_Attendance_View")) tasks.Add(LoadAttendanceAsync(siteId));
                await Task.WhenAll(tasks);
                var employeeIds = _employees.Select(x => x.Id).ToHashSet();
                if (siteId.HasValue && _attendance.Count > 0) employeeIds.IntersectWith(_attendance.Select(x => x.EmployeeId));
                if (_hasActiveSiteAccess && employeeIds.Count == 0)
                {
                    _timesheets.Clear();
                    _leave.Clear();
                    _payroll.Clear();
                }
                else
                {
                    tasks.Clear();
                    if (_permissions.Contains("HRM_Timesheet_View")) tasks.Add(LoadTimesheetsAsync(employeeIds, siteId));
                    if (_permissions.Contains("HRM_Leave_View")) tasks.Add(LoadLeaveAsync(employeeIds, siteId));
                    if (_permissions.Contains("HRM_Payroll_View")) tasks.Add(LoadPayrollAsync(employeeIds, siteId));
                    await Task.WhenAll(tasks);
                }
            }

            if (CanSafetyReport)
            {
                _incidents = (await ComplianceService.GetSafetyIncidentsAsync()).Where(x => InScope(x.ConstructionSiteId)).ToList();
                var client = HttpClientFactory.CreateClient("CSM.Api");
                await AuthService.ApplyAuthenticationAsync(client);
                var inspections = await client.GetFromJsonAsync<List<JsonElement>>("Inspections") ?? [];
                var permits = await client.GetFromJsonAsync<List<JsonElement>>("Permits") ?? [];
                _inspections = inspections.Where(x => InScope(JsonGuid(x, "constructionSiteId"))).ToList();
                _permits = permits.Where(x => InScope(JsonGuid(x, "constructionSiteId"))).ToList();
            }
        }
        catch (Exception ex)
        {
            _operationalError = FriendlyError(ex);
        }
        finally { _operationalBusy = false; }
    }

    private async Task LoadRequestsAsync(Func<Guid, bool> inScope) => _materialRequests = (await ProcurementService.GetMaterialRequestsAsync()).Where(x => inScope(x.ConstructionSiteId)).ToList();
    private async Task LoadOrdersAsync(Func<Guid, bool> inScope) => _purchaseOrders = (await ProcurementService.GetPurchaseOrdersAsync()).Where(x => inScope(x.ConstructionSiteId)).ToList();
    private async Task LoadReceiptsAsync(Func<Guid, bool> inScope) => _goodsReceipts = (await ProcurementService.GetGoodsReceiptsAsync()).Where(x => inScope(x.ConstructionSiteId)).ToList();
    private async Task LoadEmployeesAsync() => _employees = (await EmployeeService.GetEmployeesAsync(employeeScope: _scope == "Site" ? "Site" : null)).ToList();
    private async Task LoadAttendanceAsync(Guid? siteId) => _attendance = (await AttendanceService.GetAttendancesAsync(constructionSiteId: siteId)).ToList();
    private async Task LoadTimesheetsAsync(HashSet<Guid> ids, Guid? siteId) { var all = await TimesheetService.GetAllAsync(); _timesheets = all.Where(x => (ids.Count == 0 || ids.Contains(x.EmployeeId)) && (siteId is null || _attendance.Any(a => a.EmployeeId == x.EmployeeId))).ToList(); }
    private async Task LoadLeaveAsync(HashSet<Guid> ids, Guid? siteId) { var all = await LeaveService.GetAllAsync(); _leave = all.Where(x => (ids.Count == 0 || ids.Contains(x.EmployeeId)) && (siteId is null || _attendance.Any(a => a.EmployeeId == x.EmployeeId))).ToList(); }
    private async Task LoadPayrollAsync(HashSet<Guid> ids, Guid? siteId) { var all = await PayrollService.GetAllAsync(); _payroll = all.Where(x => (ids.Count == 0 || ids.Contains(x.EmployeeId)) && (siteId is null || _attendance.Any(a => a.EmployeeId == x.EmployeeId))).ToList(); }

