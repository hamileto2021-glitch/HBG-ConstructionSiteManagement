@page "/reports"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net
@using CSM.Web.Models.Reporting
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IReportingService ReportingService
@inject IProjectService ProjectService

<PageTitle>Reports & Analytics</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">Reports & Analytics</h2>
            <p class="text-muted mb-0">
                @ScopeIntro
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="RefreshAsync"
                disabled="@_busy">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
        </button>
    </div>

    <!-- Scope. Always visible, so an error never leaves the user stuck. -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Report Scope</label>

                    <select class="form-select"
                            @bind="_scope"
                            @bind:after="ScopeChangedAsync">
                        <option value="All">Company + all sites</option>
                        <option value="Company">Company level (not tied to a site)</option>
                        <option value="Site">Site</option>
                    </select>
                </div>

                @if (_scope == "Site")
                {
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">
                            Construction Site
                        </label>

                        <select class="form-select"
                                @bind="_selectedSiteId"
                                @bind:after="SiteChangedAsync">
                            <option value="">-- Select Site --</option>

                            @foreach (var site in VisibleSites)
                            {
                                <option value="@site.Id">
                                    @site.Name (@site.SiteCode)
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="col-md-3">
                    <div class="text-muted small">Current Scope</div>
                    <div class="fw-semibold">@CurrentScopeLabel</div>
                </div>

            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_sitesError))
    {
        <div class="alert alert-warning">@_sitesError</div>
    }

    @if (_busy)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"></div>
            <div class="mt-2">Loading reports...</div>
        </div>
    }
    else if (_scope == "Site" && !HasSelectedSite)
    {
        <div class="alert alert-info">
            Select a construction site to see its reports.
        </div>
    }
    else
    {
        <!-- Executive report (sites and projects only exist per site, so it is not shown for company level) -->
        @if (_scope != "Company")
        {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Executive Report
                        </h5>
                        <small>
                            @ExecutiveSubtitle
                        </small>
                    </div>

                    <span class="badge bg-light text-dark">
                        @CurrentScopeLabel
                    </span>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_executiveError))
                {
                    <div class="alert alert-danger mb-0">@_executiveError</div>
                }
                else if (Executive is not null)
                {
                    <div class="row g-3">

                        @Tile("Construction Sites",
                            SitesText(Executive),
                            col: "col-md-6 col-xl-3")

                        @Tile("Projects",
                            Executive.TotalProjects.ToString("N0"),
                            col: "col-md-6 col-xl-3")

                        @Tile("Contract Value",
                            Money(Executive.TotalContractValue),
                            hint: "All projects",
                            col: "col-md-6 col-xl-3")

                        @Tile("Budget",
                            Money(Executive.TotalBudget),
                            hint: "Approved, active and closed budgets",
                            col: "col-md-6 col-xl-3")

                        @UsedTile(Executive.TotalBudget,
                            Executive.TotalExpenses,
                            "col-md-6 col-xl-3")

                        @Tile("Invoiced to Clients",
                            Money(Executive.TotalInvoices),
                            col: "col-md-6 col-xl-3")

                        @Tile("Collected",
                            Money(Executive.TotalCompletedPayments),
                            css: "text-success",
                            hint: "Completed incoming payments",
                            col: "col-md-6 col-xl-3")

                        @Tile("Outstanding Invoices",
                            Money(Executive.OutstandingInvoices),
                            css: "text-warning",
                            hint: "Unpaid balance of client invoices",
                            col: "col-md-6 col-xl-3")

                    </div>

                    <hr class="my-4" />

                    <div class="row g-4">

                        <div class="col-lg-6">
                            <h6 class="fw-bold mb-3">Sites by Status</h6>

                            @if (Executive.SitesByStatus.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Status</th>
                                                <th class="text-end">Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Executive.SitesByStatus)
                                            {
                                                <tr>
                                                    <td>@item.Key</td>
                                                    <td class="text-end">@item.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    No site status data available.
                                </div>
                            }
                        </div>

                        <div class="col-lg-6">
                            <h6 class="fw-bold mb-3">Projects by Status</h6>

                            @if (Executive.ProjectsByStatus.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Status</th>
                                                <th class="text-end">Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Executive.ProjectsByStatus)
                                            {
                                                <tr>
                                                    <td>@item.Key</td>
                                                    <td class="text-end">@item.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    No project status data available.
                                </div>
                            }
                        </div>

                    </div>
                }

            </div>
        </div>

        }

        <!-- Financial report -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-cash-stack me-2"></i>
                            Financial Report
                        </h5>
                        <small>
                            @FinancialSubtitle
                        </small>
                    </div>

                    <span class="badge bg-light text-dark">
                        @CurrentScopeLabel
                    </span>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_financialError))
                {
                    <div class="alert alert-danger mb-0">@_financialError</div>
                }
                else if (Summary is not null)
                {
                    <h6 class="fw-bold mb-1">1. Budget</h6>
                    <div class="text-muted small mb-3">
                        Remaining = budget - expenses. Expenses = approved and paid expense
                        records + paid payroll + petty cash out.
                    </div>

                    <div class="row g-3 mb-4">

                        @Tile("Budget",
                            Money(Summary.TotalBudget),
                            hint: Split(f => f.TotalBudget, "Approved, active and closed budgets"),
                            col: "col-md-6 col-xl-3")

                        @Tile("Expenses",
                            Money(Summary.TotalExpenses),
                            css: "text-danger",
                            hint: "Expense records + paid payroll + petty cash out",
                            col: "col-md-6 col-xl-3")

                        @Tile("Remaining",
                            Money(Summary.RemainingBudget),
                            css: BalanceClass(Summary.RemainingBudget),
                            hint: "Negative means over budget",
                            col: "col-md-6 col-xl-3")

                        @UsedTile(Summary.TotalBudget, Summary.TotalExpenses, "col-md-6 col-xl-3")

                    </div>

                    <div class="small text-muted mb-4">
                        <strong>Expenses</strong> @Money(Summary.TotalExpenses) =
                        expense records @Money(Summary.ExpenseRecords) +
                        paid payroll @Money(Summary.PayrollPaid) +
                        petty cash out @Money(Summary.PettyCashOut)
                    </div>

                    <h6 class="fw-bold mb-1">2. Invoices</h6>
                    <div class="text-muted small mb-3">
                        Worked out invoice by invoice: total minus the completed payments on it.
                    </div>

                    <div class="row g-3 mb-4">

                        @Tile("Invoiced to Clients",
                            Money(Summary.TotalInvoiced),
                            hint: "Issued client invoices",
                            col: "col-md-6 col-xl-4")

                        @Tile("Clients Owe Us",
                            Money(Summary.OutstandingReceivables),
                            css: "text-warning",
                            hint: "Unpaid balance of client invoices",
                            col: "col-md-6 col-xl-4")

                        @Tile("We Owe Vendors",
                            Money(Summary.OutstandingPayables),
                            css: "text-warning",
                            hint: "Unpaid balance of vendor bills",
                            col: "col-md-6 col-xl-4")

                    </div>

                    <h6 class="fw-bold mb-1">3. Petty Cash</h6>
                    <div class="text-muted small mb-3">
                        Opening balance + cash in - cash out = balance
                        (@Summary.ActivePettyCashAccounts.ToString("N0") active accounts).
                        Top-ups move money between your own accounts.
                    </div>

                    <div class="row g-3">

                        @Tile("Opening Balance",
                            Money(Summary.PettyCashOpeningBalance),
                            hint: "Money the accounts were opened with",
                            col: "col-md-6 col-xl-3")

                        @Tile("+ Cash In",
                            Money(Summary.PettyCashIn),
                            css: "text-success",
                            hint: "Top-ups recorded",
                            col: "col-md-6 col-xl-3")

                        @Tile("- Cash Out",
                            Money(Summary.PettyCashOut),
                            css: "text-danger",
                            hint: "Spending recorded",
                            col: "col-md-6 col-xl-3")

                        @Tile("= Balance",
                            Money(Summary.PettyCashBalance),
                            hint: "What the accounts hold now",
                            col: "col-md-6 col-xl-3")

                    </div>

                    @if (HasPettyCashGap(Summary))
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <strong>Petty cash does not add up.</strong>
                            @Money(-PettyCashGap(Summary)) left an account without a cash out
                            transaction, for example a balance changed directly.
                        </div>
                    }

                    <details class="mt-4">
                        <summary class="fw-semibold">How these numbers are calculated</summary>
                        <ul class="small mt-2 mb-0">
                            <li><strong>Budget</strong>: approved, active and closed budgets.</li>
                            <li><strong>Expenses</strong> = approved and paid expense records (including tax) + paid payroll (completed payments linked to a payroll record) + petty cash out. Payments on vendor bills and other payments are not expenses. Draft, submitted, rejected and cancelled expenses, and pending payments, are not counted.</li>
                            <li><strong>Counted twice</strong>: payroll and petty cash are not linked to expense records, so a cost entered as an expense and also as payroll or petty cash is counted twice.</li>
                            <li><strong>Invoices</strong>: issued invoices only. For each one, the unpaid balance is its total minus the completed payments on it (never below zero); the balances are then added up.</li>
                            <li><strong>Petty cash</strong>: the opening balance is what an account was opened with, worked out as balance - cash in + cash out.</li>
                            <li><strong>Where a record belongs</strong>: a payment belongs to its invoice's site, or to its own site when it has no invoice. Company level means records with no site.</li>
                        </ul>
                    </details>
                }

            </div>
        </div>

        <!-- Company breakdown: head office + every site, with a total that adds up -->
        @if (_scope == "All" && _all is not null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">
                                <i class="bi bi-bar-chart-line me-2"></i>
                                Breakdown by Site
                            </h5>
                            <small>
                                Head office and each construction site. The
                                total row is the company-wide figure above.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Site</th>
                                    <th>Code</th>
                                    <th class="text-end">Budget</th>
                                    <th class="text-end">Expenses</th>
                                    <th class="text-end">Used</th>
                                    <th class="text-end">Invoiced</th>
                                    <th class="text-end">Clients Owe</th>
                                    <th class="text-end">We Owe</th>
                                    <th class="text-end">Petty Cash</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var row in BreakdownRows)
                                {
                                    @DataRow(row)
                                }
                            </tbody>

                            <tfoot>
                                @DataRow(TotalRow, bold: true)
                            </tfoot>
                        </table>
                    </div>

                    @if (HasOtherRow)
                    {
                        <div class="text-muted small">
                            "Other" is activity recorded against sites that no
                            longer exist. It is included in the total.
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Future report modules -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Additional Management Reports</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    @Upcoming("bi-kanban", "Project Progress Report",
                        "Planned versus actual progress, milestones and delays.")

                    @Upcoming("bi-building", "Site Operations Report",
                        "Site activity, materials, equipment and progress.")

                    @Upcoming("bi-people", "HR Report",
                        "Employees, attendance, timesheets, leave and payroll.")

                    @Upcoming("bi-box-seam", "Procurement & Inventory",
                        "Requests, purchase orders, receipts and stock.")

                    @Upcoming("bi-shield-check", "Safety & Compliance",
                        "Incidents, inspections, permits and corrective actions.")

                </div>
            </div>
        </div>
    }

</div>

@code {

    // Company scope data (kept while the user looks at a site).
    private ExecutiveDashboardResponse? _allExecutive;
    private AllFinancialSummaryResponse? _all;
    private FinancialSummaryResponse? _companyLevelSummary;

    // Site scope data.
    private ExecutiveDashboardResponse? _siteExecutive;
    private FinancialSummaryResponse? _siteSummary;

    private List<SiteResponse> _sites = [];

    private string _scope = "All";
    private string _selectedSiteId = string.Empty;

    private bool _busy = true;

    // Each section reports its own problem, so one failure never blanks
    // the page or hides the selectors.
    private string? _sitesError;
    private string? _executiveError;
    private string? _financialError;

    // What the two main sections show, for the current scope. For the company
    // scope this is the company-wide total (head office + all sites), not the
    // head-office-only record set.
    // "All"     company + every site (the combined total)
    // "Company" company-level records only, not tied to any site
    // "Site"    one construction site
    private ExecutiveDashboardResponse? Executive
        => _scope == "All" ? _allExecutive
         : _scope == "Site" ? _siteExecutive
         : null;

    private FinancialSummaryResponse? Summary
        => _scope == "All" ? _all?.Total
         : _scope == "Site" ? _siteSummary
         : _companyLevelSummary;

    private bool HasSelectedSite => Guid.TryParse(_selectedSiteId, out _);

    // Only sites the user can open: the reporting service already limits the
    // breakdown to those.
    private List<SiteResponse> VisibleSites
    {
        get
        {
            if (_all is null)
            {
                return _sites;
            }

            var ids = _all.Sites
                .Select(s => s.SiteId)
                .ToHashSet();

            return _sites
                .Where(s => ids.Contains(s.Id))
                .ToList();
        }
    }

    private string CurrentScopeLabel
        => _scope == "All" ? "Company + all sites"
         : _scope == "Company" ? "Company level"
         : _sites.FirstOrDefault(x => x.Id.ToString() == _selectedSiteId)?.Name
           ?? "Select a construction site";

    private string ScopeIntro
        => _scope == "All" ? "Company-wide management reports and financial analytics."
         : _scope == "Company" ? "Company-level financial records that are not tied to a construction site."
         : $"{CurrentScopeLabel} management reports and financial analytics.";

    private string ExecutiveSubtitle
        => _scope == "All"
            ? "Company-wide management overview"
            : $"{CurrentScopeLabel} management overview";

    private string FinancialSubtitle
        => _scope == "All" ? "Company-wide financial position (company level and all sites)"
         : _scope == "Company" ? "Budgets, expenses and payments not tied to a construction site"
         : $"{CurrentScopeLabel} financial position";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sites = await ProjectService.GetSitesAsync();
        }
        catch (Exception ex)
        {
            _sitesError = $"Failed to load construction sites. {FriendlyError(ex)}";
        }

        await LoadAllAsync();
    }

    private async Task ScopeChangedAsync()
    {
        ClearErrors();

        if (_scope == "Site")
        {
            _siteExecutive = null;
            _siteSummary = null;
            return;
        }

        _selectedSiteId = string.Empty;

        if (_scope == "All")
        {
            if (_allExecutive is null && _all is null)
            {
                await LoadAllAsync();
            }
        }
        else if (_companyLevelSummary is null)
        {
            await LoadCompanyLevelAsync();
        }
    }

    private async Task SiteChangedAsync()
    {
        ClearErrors();

        if (!Guid.TryParse(_selectedSiteId, out var siteId))
        {
            _siteExecutive = null;
            _siteSummary = null;
            return;
        }

        await LoadSiteAsync(siteId);
    }

    private async Task RefreshAsync()
    {
        if (_scope == "Site" && Guid.TryParse(_selectedSiteId, out var siteId))
        {
            await LoadSiteAsync(siteId);
        }
        else if (_scope == "Company")
        {
            await LoadCompanyLevelAsync();
        }
        else
        {
            await LoadAllAsync();
        }
    }

    private async Task LoadCompanyLevelAsync()
    {
        _busy = true;
        ClearErrors();

        _companyLevelSummary = null;

        try
        {
            _companyLevelSummary = await ReportingService.GetFinancialSummaryAsync();
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _financialError =
                "Company-level figures are only visible to roles with company-wide access.";
        }
        catch (Exception ex)
        {
            _financialError = FriendlyError(ex);
        }

        _busy = false;
    }

    private async Task LoadAllAsync()
    {
        _busy = true;
        ClearErrors();

        _allExecutive = null;
        _all = null;

        try
        {
            _allExecutive = await ReportingService.GetExecutiveDashboardAsync();
        }
        catch (Exception ex)
        {
            _executiveError = FriendlyError(ex);
        }

        // One call gives head office, every site and the company total.
        try
        {
            _all = await ReportingService.GetAllFinancialSummariesAsync();
        }
        catch (Exception ex)
        {
            _financialError = FriendlyError(ex);
        }

        _busy = false;
    }

    private async Task LoadSiteAsync(Guid siteId)
    {
        _busy = true;
        ClearErrors();

        _siteExecutive = null;
        _siteSummary = null;

        try
        {
            _siteExecutive = await ReportingService.GetSiteExecutiveDashboardAsync(siteId);
        }
        catch (Exception ex)
        {
            _executiveError = FriendlyError(ex);
        }

        try
        {
            _siteSummary = await ReportingService.GetSiteFinancialSummaryAsync(siteId);
        }
        catch (Exception ex)
        {
            _financialError = FriendlyError(ex);
        }

        _busy = false;
    }

    private void ClearErrors()
    {
        _executiveError = null;
        _financialError = null;
    }

    private static string FriendlyError(Exception ex)
    {
        if (ex is HttpRequestException { StatusCode: HttpStatusCode.Forbidden })
        {
            return "You don't have permission to view this report, " +
                   "or you are not assigned to this site.";
        }

        return string.IsNullOrWhiteSpace(ex.Message)
            ? "The report could not be loaded."
            : ex.Message;
    }

    // ------------------------------------------------------------------
    // Breakdown table
    // ------------------------------------------------------------------

    private sealed record Row(
        string Name,
        string Code,
        decimal Budget,
        decimal Expenses,
        decimal Invoiced,
        decimal Receivables,
        decimal Payables,
        decimal PettyBalance);

    private static Row ToRow(string name, string code, FinancialSummaryResponse f)
        => new(
            name,
            code,
            f.TotalBudget,
            f.TotalExpenses,
            f.TotalInvoiced,
            f.OutstandingReceivables,
            f.OutstandingPayables,
            f.PettyCashBalance);

    private Row TotalRow
        => ToRow("Total", string.Empty, _all!.Total);

    // Head office first, then each site, then "Other" when the total holds
    // activity that belongs to no listed site (sites that were deleted).
    private List<Row> BreakdownRows
    {
        get
        {
            var rows = new List<Row>
            {
                ToRow("Head office (company level)", string.Empty, _all!.Company)
            };

            rows.AddRange(_all.Sites.Select(
                s => ToRow(s.SiteName, s.SiteCode, s.Financial)));

            if (OtherRow is { } other)
            {
                rows.Add(other);
            }

            return rows;
        }
    }

    private bool HasOtherRow => OtherRow is not null;

    private Row? OtherRow
    {
        get
        {
            if (_all is null)
            {
                return null;
            }

            var listed = new List<Row> { ToRow("", "", _all.Company) };
            listed.AddRange(_all.Sites.Select(s => ToRow("", "", s.Financial)));

            var total = TotalRow;

            decimal Gap(Func<Row, decimal> pick) => pick(total) - listed.Sum(pick);

            var other = new Row(
                "Other (deleted sites)",
                string.Empty,
                Gap(r => r.Budget),
                Gap(r => r.Expenses),
                Gap(r => r.Invoiced),
                Gap(r => r.Receivables),
                Gap(r => r.Payables),
                Gap(r => r.PettyBalance));

            var isEmpty = new[]
                {
                    other.Budget, other.Expenses, other.Invoiced,
                    other.Receivables, other.Payables, other.PettyBalance
                }
                .All(v => Math.Abs(v) < 0.005m);

            return isEmpty ? null : other;
        }
    }

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    private static string Money(decimal value) => value.ToString("N2");


    // What the accounts hold, minus what opening + cash in - cash out allow.
    // Zero when the figures add up.
    private static decimal PettyCashGap(FinancialSummaryResponse f)
        => f.PettyCashBalance
           - (f.PettyCashOpeningBalance + f.PettyCashIn - f.PettyCashOut);

    private static bool HasPettyCashGap(FinancialSummaryResponse f)
        => Math.Abs(PettyCashGap(f)) >= 0.005m;


    // Under the combined view, show how a figure splits between the
    // company-level (non-site) records and the sites.
    private string Split(Func<FinancialSummaryResponse, decimal> pick, string fallback)
        => _scope == "All" && _all is not null
            ? $"Company level {Money(pick(_all.Company))} + sites {Money(pick(_all.Total) - pick(_all.Company))}"
            : fallback;

    private static string SitesText(ExecutiveDashboardResponse e)
        => $"{e.ActiveSites:N0} active of {e.TotalSites:N0}";

    private static string BalanceClass(decimal value)
        => value < 0 ? "text-danger" : "text-success";

    private static decimal UsedPercent(decimal budget, decimal expenses)
        => budget <= 0m ? 0m : Math.Round(expenses / budget * 100m, 1);

    // Same thresholds as the budget alerts: 80% warning, 100% limit reached.
    private static string UsedClass(decimal percent)
        => percent >= 100m ? "bg-danger"
         : percent >= 80m ? "bg-warning"
         : "bg-success";

    private RenderFragment Tile(
        string label,
        string value,
        string css = "",
        string? hint = null,
        string col = "col-md-6 col-xl-4") =>
        @<div class="@col">
            <div class="card h-100 border">
                <div class="card-body">
                    <div class="text-muted small">@label</div>
                    <div class="fs-5 fw-bold @css">@value</div>
                    @if (hint is not null)
                    {
                        <div class="text-muted small mt-1">@hint</div>
                    }
                </div>
            </div>
        </div>;

    private RenderFragment UsedTile(decimal budget, decimal expenses, string col)
    {
        var percent = UsedPercent(budget, expenses);

        return @<div class="@col">
            <div class="card h-100 border">
                <div class="card-body">
                    <div class="text-muted small">Budget Used</div>
                    <div class="fs-5 fw-bold">@percent.ToString("0.#")%</div>
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar @UsedClass(percent)"
                             role="progressbar"
                             style="width: @(Math.Min(percent, 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%">
                        </div>
                    </div>
                    <div class="text-muted small mt-1">
                        Expenses against budget
                    </div>
                </div>
            </div>
        </div>;
    }

    private RenderFragment DataRow(Row r, bool bold = false)
    {
        var used = UsedPercent(r.Budget, r.Expenses);

        return @<tr class="@(bold ? "table-light fw-bold" : "")">
            <td class="@(bold ? "" : "fw-semibold")">@r.Name</td>
            <td>@r.Code</td>
            <td class="text-end">@Money(r.Budget)</td>
            <td class="text-end">@Money(r.Expenses)</td>
            <td class="text-end">
                @if (r.Budget > 0m)
                {
                    <span class="badge @UsedClass(used)">@used.ToString("0.#")%</span>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </td>
            <td class="text-end">@Money(r.Invoiced)</td>
            <td class="text-end">@Money(r.Receivables)</td>
            <td class="text-end">@Money(r.Payables)</td>
            <td class="text-end">@Money(r.PettyBalance)</td>
        </tr>;
    }

    private RenderFragment Upcoming(string icon, string title, string text) =>
        @<div class="col-md-6 col-lg-4">
            <div class="card h-100 border">
                <div class="card-body">
                    <h6>
                        <i class="bi @icon me-2"></i>
                        @title
                    </h6>
                    <p class="text-muted small">@text</p>
                    <button class="btn btn-outline-primary" disabled>
                        Coming Next
                    </button>
                </div>
            </div>
        </div>;
}
