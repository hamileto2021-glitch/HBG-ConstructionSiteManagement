    private static string ProgressWidth(decimal percentage) => $"{Math.Clamp(percentage, 0m, 100m):0.#}%";
    private static Guid JsonGuid(JsonElement item, string property)
        => item.TryGetProperty(property, out var value) && value.TryGetGuid(out var id) ? id : Guid.Empty;
    private static string JsonText(JsonElement item, string property)
        => item.TryGetProperty(property, out var value) ? value.ToString() : string.Empty;

    private static string FriendlyError(Exception ex)
    {
        if (ex is HttpRequestException { StatusCode: HttpStatusCode.Forbidden })
        {
            return "You don't have permission to view this report, " +
                   "or you are not assigned to this site.";
        }

        return string.IsNullOrWhiteSpace(ex.Message)
            ? "The report could not be loaded."
            : ex.Message;
    }

    // ------------------------------------------------------------------
    // Breakdown table
    // ------------------------------------------------------------------

    private sealed record Row(
        string Name,
        string Code,
        decimal Budget,
        decimal Expenses,
        decimal Invoiced,
        decimal Receivables,
        decimal Payables,
        decimal PettyBalance);

    private static Row ToRow(string name, string code, FinancialSummaryResponse f)
        => new(
            name,
            code,
            f.TotalBudget,
            f.TotalExpenses,
            f.TotalInvoiced,
            f.OutstandingReceivables,
            f.OutstandingPayables,
            f.PettyCashBalance);

    private Row TotalRow
        => ToRow("Total", string.Empty, _all!.Total);

    // Head office first, then each site, then "Other" when the total holds
    // activity that belongs to no listed site (sites that were deleted).
    private List<Row> BreakdownRows
    {
        get
        {
            var all = _all!;
            var rows = new List<Row>();

            if (_canViewCompanyWideFinancials)
            {
                rows.Add(
                    ToRow(
                        "Head office (company level)",
                        string.Empty,
                        all.Company));
            }

            rows.AddRange(all.Sites.Select(
                s => ToRow(s.SiteName, s.SiteCode, s.Financial)));

            if (OtherRow is { } other)
            {
                rows.Add(other);
            }

            return rows;
        }
    }

    private bool HasOtherRow => OtherRow is not null;

    private Row? OtherRow
    {
        get
        {
            if (_all is null)
            {
                return null;
            }

            var listed = new List<Row>();
            if (_canViewCompanyWideFinancials)
            {
                listed.Add(ToRow("", "", _all.Company));
            }

            listed.AddRange(_all.Sites.Select(s => ToRow("", "", s.Financial)));

            var total = TotalRow;

            decimal Gap(Func<Row, decimal> pick) => pick(total) - listed.Sum(pick);

            var other = new Row(
                "Other (deleted sites)",
                string.Empty,
                Gap(r => r.Budget),
                Gap(r => r.Expenses),
                Gap(r => r.Invoiced),
                Gap(r => r.Receivables),
                Gap(r => r.Payables),
                Gap(r => r.PettyBalance));

            var isEmpty = new[]
                {
                    other.Budget, other.Expenses, other.Invoiced,
                    other.Receivables, other.Payables, other.PettyBalance
                }
                .All(v => Math.Abs(v) < 0.005m);

            return isEmpty ? null : other;
        }
    }

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    private static string Money(decimal value) => value.ToString("N2");


    // What the accounts hold, minus what opening + cash in - cash out allow.
    // Zero when the figures add up.
    private static decimal PettyCashGap(FinancialSummaryResponse f)
        => f.PettyCashBalance
           - (f.PettyCashOpeningBalance + f.PettyCashIn - f.PettyCashOut);

    private static bool HasPettyCashGap(FinancialSummaryResponse f)
        => Math.Abs(PettyCashGap(f)) >= 0.005m;


    // Under the combined view, show how a figure splits between the
    // company-level (non-site) records and the sites.
    private string Split(Func<FinancialSummaryResponse, decimal> pick, string fallback)
        => _scope == "All" && _all is not null
            ? $"Company level {Money(pick(_all.Company))} + sites {Money(pick(_all.Total) - pick(_all.Company))}"
            : fallback;

    private static string SitesText(ExecutiveDashboardResponse e)
        => $"{e.ActiveSites:N0} active of {e.TotalSites:N0}";

    private static string BalanceClass(decimal value)
        => value < 0 ? "text-danger" : "text-success";

    private static decimal UsedPercent(decimal budget, decimal expenses)
        => budget <= 0m ? 0m : Math.Round(expenses / budget * 100m, 1);

    // Same thresholds as the budget alerts: 80% warning, 100% limit reached.
    private static string UsedClass(decimal percent)
        => percent >= 100m ? "bg-danger"
         : percent >= 80m ? "bg-warning"
         : "bg-success";

    private RenderFragment Tile(
        string label,
        string value,
        string css = "",
        string? hint = null,
        string col = "col-md-6 col-xl-4") =>
        @<div class="@col">
            <div class="card h-100 border">
                <div class="card-body">
                    <div class="text-muted small">@label</div>
                    <div class="fs-5 fw-bold @css">@value</div>
                    @if (hint is not null)
                    {
                        <div class="text-muted small mt-1">@hint</div>
                    }
                </div>
            </div>
        </div>;

    private RenderFragment UsedTile(decimal budget, decimal expenses, string col)
    {
        var percent = UsedPercent(budget, expenses);

        return @<div class="@col">
            <div class="card h-100 border">
                <div class="card-body">
                    <div class="text-muted small">Budget Used</div>
                    <div class="fs-5 fw-bold">@percent.ToString("0.#")%</div>
                    <div class="progress mt-2" style="height: 8px;">
                        <div class="progress-bar @UsedClass(percent)"
                             role="progressbar"
                             style="width: @(Math.Min(percent, 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%">
                        </div>
                    </div>
                    <div class="text-muted small mt-1">
                        Expenses against budget
                    </div>
                </div>
            </div>
        </div>;
    }

    private RenderFragment DataRow(Row r, bool bold = false)
    {
        var used = UsedPercent(r.Budget, r.Expenses);

        return @<tr class="@(bold ? "table-light fw-bold" : "")">
            <td class="@(bold ? "" : "fw-semibold")">@r.Name</td>
            <td>@r.Code</td>
            <td class="text-end">@Money(r.Budget)</td>
            <td class="text-end">@Money(r.Expenses)</td>
            <td class="text-end">
                @if (r.Budget > 0m)
                {
                    <span class="badge @UsedClass(used)">@used.ToString("0.#")%</span>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </td>
            <td class="text-end">@Money(r.Invoiced)</td>
            <td class="text-end">@Money(r.Receivables)</td>
            <td class="text-end">@Money(r.Payables)</td>
            <td class="text-end">@Money(r.PettyBalance)</td>
        </tr>;
    }

    private RenderFragment ReportLink(string icon, string title, string text, string href) =>
        @<div class="col-md-6 col-lg-4">
            <div class="card h-100 border">
                <div class="card-body">
                    <h6>
                        <i class="bi @icon me-2"></i>
                        @title
                    </h6>
                    <p class="text-muted small">@text</p>
                    <a class="btn btn-outline-primary" href="@href">Open report data</a>
                </div>
            </div>
        </div>;
}
