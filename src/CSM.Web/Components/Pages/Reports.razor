        @foreach (var p in _projects) { var milestones = _milestones.GetValueOrDefault(p.Id) ?? []; var late = milestones.Count(m => !m.ActualDate.HasValue && m.PlannedDate < DateOnly.FromDateTime(DateTime.Today));
