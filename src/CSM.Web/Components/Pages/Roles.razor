@page "/roles"

@using CSM.Web.Models.Roles
@using CSM.Web.Services

@inject RoleWebService RoleService
@inject NavigationManager Navigation

<PageTitle>Role Permissions</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Permission Matrix</h3>

    <button class="btn btn-outline-secondary"
            @onclick="Back">
        <span class="bi bi-arrow-left me-2"></span>
        Back
    </button>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <label class="form-label">Role</label>

            <select class="form-select"
                    value="@selectedRoleId"
                    @onchange="OnRoleChanged">

                @foreach (var role in roles)
                {
                    <option value="@role.Id">
                        @role.Name
                    </option>
                }

            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_saveMessage))
    {
        <div class="alert @(_saveSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show"
             role="alert">
            @_saveMessage
            <button type="button" class="btn-close" @onclick="() => _saveMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header">
            Permissions
        </div>

        <div class="card-body">

            @foreach (var item in permissions)
            {
                <div class="form-check mb-2">

                    <input class="form-check-input"
                           type="checkbox"
                           disabled="@_saving"
                           @bind="item.Granted"/>

                    <label class="form-check-label">
                        @item.Permission
                    </label>

                </div>
            }

        </div>

        <div class="card-footer text-end">

            <button class="btn btn-primary"
                    disabled="@_saving"
                    @onclick="Save">

                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Changes</span>
                }

            </button>

        </div>

    </div>
}

@code {

    private List<RoleSummaryModel> roles = [];

    private List<RolePermissionModel> permissions = [];

    private Guid selectedRoleId;

    private bool loading = true;

    private bool _saving;
    private bool _saveSuccess;
    private string? _saveMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        roles = await RoleService.GetRolesAsync();

        if (roles.Any())
        {
            selectedRoleId = roles.First().Id;

            permissions =
                await RoleService.GetPermissionsAsync(selectedRoleId);
        }

        loading = false;

        StateHasChanged();
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        selectedRoleId = Guid.Parse(e.Value!.ToString()!);

        permissions = await RoleService.GetPermissionsAsync(selectedRoleId);

        // A role switch invalidates any save confirmation/error
        // from the previously selected role.
        _saveMessage = null;
    }

    private async Task Save()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _saveMessage = null;

        try
        {
            await RoleService.SavePermissionsAsync(
                selectedRoleId,
                permissions);

            var roleName = roles.FirstOrDefault(r => r.Id == selectedRoleId)?.Name;

            _saveSuccess = true;
            _saveMessage = $"Permissions saved for {roleName}.";
        }
        catch (Exception ex)
        {
            _saveSuccess = false;
            _saveMessage = $"Couldn't save permissions: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users");
    }
}
