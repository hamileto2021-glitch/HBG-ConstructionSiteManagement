@page "/hr"
@rendermode InteractiveServer

@using CSM.Web.Services

@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IContractorService ContractorService
@inject ILogger<Hr> Logger

<PageTitle>HR Management | CSM</PageTitle>

<main class="hr-page">
    @if (!_ready)
    {
        <section class="hr-loading" role="status" aria-live="polite">
            <span class="hr-loading-icon" aria-hidden="true">
                <i class="bi bi-people"></i>
            </span>
            <span>Loading your HR workspace…</span>
        </section>
    }
    else
    {
        <header class="hr-header">
            <div>
                <div class="hr-eyebrow">
                    <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                    People &amp; workforce
                </div>
                <h1>Human Resources</h1>
                <p>Manage your workforce, site staffing, attendance, and payroll.</p>
            </div>
            <div class="hr-header-badge">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Access-controlled workspace</span>
            </div>
        </header>

        @if (_contractorLoadFailed)
        {
            <div class="hr-inline-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>Contractor information is unavailable right now.</span>
                <button type="button" @onclick="LoadContractorCountAsync" disabled="@_contractorLoading">
                    @if (_contractorLoading)
                    {
                        <span>Retrying…</span>
                    }
                    else
                    {
                        <span>Try again</span>
                    }
                </button>
            </div>
        }

        @if (_canViewEmployees || _canViewContractors || _canViewAttendance ||
             _canViewShifts || _canViewLeave || _canViewPayroll)
        {
            <section class="hr-section" aria-labelledby="hr-sections-title">
                <div class="hr-section-heading">
                    <div>
                        <h2 id="hr-sections-title">Your HR sections</h2>
                        <p>Choose an area to view and manage its records.</p>
                    </div>
                </div>

                <div class="hr-card-grid">
                    @if (_canViewEmployees)
                    {
                        <article class="hr-card hr-card-blue">
                            <div class="hr-card-topline">
                                <span class="hr-card-icon" aria-hidden="true">
                                    <i class="bi bi-person-vcard"></i>
                                </span>
                                <span class="hr-card-category">Workforce</span>
                            </div>
                            <h3>Employees</h3>
                            <p>Browse employee records and manage workforce details.</p>
                            <div class="hr-card-actions">
                                @if (_showCompanyEmployeesButton)
                                {
                                    <button class="hr-primary-button" type="button" @onclick="OpenCompanyEmployees">
                                        <i class="bi bi-building" aria-hidden="true"></i>
                                        Company
                                    </button>
                                }
                                <button class="hr-secondary-button" type="button" @onclick="OpenSiteEmployees">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                    Site
                                </button>
                            </div>
                        </article>

                        @if (_canViewSiteAssignments)
                        {
                            <article class="hr-card hr-card-indigo">
                                <div class="hr-card-topline">
                                    <span class="hr-card-icon" aria-hidden="true">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </span>
                                    <span class="hr-card-category">Deployment</span>
                                </div>
                                <h3>Site assignments</h3>
                                <p>Assign employees to sites and review current placements.</p>
                                <button class="hr-card-link" type="button" @onclick="OpenSiteAssignments">
                                    Manage assignments
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                            </article>
                        }
                    }

                    @if (_canViewContractors)
                    {
                        <article class="hr-card hr-card-orange">
                            <div class="hr-card-topline">
                                <span class="hr-card-icon" aria-hidden="true">
                                    <i class="bi bi-hard-hat"></i>
                                </span>
                                <span class="hr-card-category">Partners</span>
                            </div>
                            <div class="hr-card-metric" aria-live="polite">
                                @if (_contractorLoading)
                                {
                                    <span class="hr-metric-loading" aria-label="Loading contractor count"></span>
                                }
                                else
                                {
                                    <span>@_contractorCount</span>
                                }
                                <span>contractors</span>
                            </div>
                            <h3>Contractors</h3>
                            <p>View and maintain contractor information.</p>
                            <button class="hr-card-link" type="button" @onclick="OpenContractors">
                                Manage contractors
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </article>
                    }

                    @if (_canViewAttendance)
                    {
                        <article class="hr-card hr-card-green">
                            <div class="hr-card-topline">
                                <span class="hr-card-icon" aria-hidden="true">
                                    <i class="bi bi-calendar2-check"></i>
                                </span>
                                <span class="hr-card-category">Time &amp; attendance</span>
                            </div>
                            <h3>Attendance</h3>
                            <p>Review attendance and manage employee check-ins.</p>
                            <button class="hr-card-link" type="button" @onclick="OpenAttendance">
                                Manage attendance
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </article>

                        @if (_canViewTimesheets)
                        {
                            <article class="hr-card hr-card-cyan">
                                <div class="hr-card-topline">
                                    <span class="hr-card-icon" aria-hidden="true">
                                        <i class="bi bi-calendar-week"></i>
                                    </span>
                                    <span class="hr-card-category">Time &amp; attendance</span>
                                </div>
                                <h3>Timesheets</h3>
                                <p>Review and manage employee timesheet records.</p>
                                <button class="hr-card-link" type="button" @onclick="OpenTimesheets">
                                    Manage timesheets
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                            </article>
                        }
                    }

                    @if (_canViewShifts)
                    {
                        <article class="hr-card hr-card-violet">
                            <div class="hr-card-topline">
                                <span class="hr-card-icon" aria-hidden="true">
                                    <i class="bi bi-calendar2-range"></i>
                                </span>
                                <span class="hr-card-category">Scheduling</span>
                            </div>
                            <h3>Shifts</h3>
                            <p>Plan and manage workforce shift schedules.</p>
                            <button class="hr-card-link" type="button" @onclick="OpenShifts">
                                Manage shifts
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </article>
                    }

                    @if (_canViewLeave)
                    {
                        <article class="hr-card hr-card-teal">
                            <div class="hr-card-topline">
                                <span class="hr-card-icon" aria-hidden="true">
                                    <i class="bi bi-calendar2-minus"></i>
                                </span>
                                <span class="hr-card-category">Time away</span>
                            </div>
                            <h3>Leave management</h3>
                            <p>Review leave requests and manage time-off records.</p>
                            <button class="hr-card-link" type="button" @onclick="OpenLeave">
                                Manage leave
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </article>
                    }

                    @if (_canViewPayroll)
                    {
                        <article class="hr-card hr-card-slate">
                            <div class="hr-card-topline">
                                <span class="hr-card-icon" aria-hidden="true">
                                    <i class="bi bi-wallet2"></i>
                                </span>
                                <span class="hr-card-category">Compensation</span>
                            </div>
                            <h3>Payroll</h3>
                            <p>Access payroll records and manage compensation workflows.</p>
                            <button class="hr-card-link" type="button" @onclick="OpenPayroll">
                                Manage payroll
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </article>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="hr-empty-state" role="status">
                <span class="hr-empty-icon" aria-hidden="true">
                    <i class="bi bi-shield-lock"></i>
                </span>
                <h2>No HR sections available</h2>
                <p>You don’t currently have permission to access any HR sections. Contact your administrator if you need access.</p>
            </section>
        }
    }
</main>

@code {
    private int _contractorCount;
    private bool _ready;
    private bool _contractorLoading;
    private bool _contractorLoadFailed;
    private bool _canViewEmployees;
    private bool _showCompanyEmployeesButton = true;
    private bool _canViewSiteAssignments;
    private bool _canViewTimesheets;
    private bool _canViewContractors;
    private bool _canViewAttendance;
    private bool _canViewShifts;
    private bool _canViewLeave;
    private bool _canViewPayroll;

    protected override async Task OnInitializedAsync()
    {
        var permissions = await AuthService.GetPermissionsAsync();
        _canViewEmployees = permissions.Contains("HRM_Employee_View");

        var userScope = await AuthService.GetCurrentUserScopeAsync();

        var isSupervisor = userScope.Roles.Any(role =>
            string.Equals(role, "Supervisor", StringComparison.OrdinalIgnoreCase));

        _canViewSiteAssignments =
            permissions.Contains("HRM_SiteAssignment_View") &&
            !isSupervisor;

        _canViewTimesheets = permissions.Contains("HRM_Timesheet_View");

        _showCompanyEmployeesButton = !userScope.HasActiveSiteAccess;

        _canViewContractors = permissions.Contains("HRM_Contractor_View");
        _canViewAttendance = permissions.Contains("HRM_Attendance_View");
        _canViewShifts = permissions.Contains("HRM_Shift_View");
        _canViewLeave = permissions.Contains("HRM_Leave_View");
        _canViewPayroll = permissions.Contains("HRM_Payroll_View");

        var accessibleRoutes = new List<string>();
        if (_canViewEmployees)
        {
            accessibleRoutes.Add(userScope.HasActiveSiteAccess
                ? "/hr/employees/site"
                : "/hr/employees/company");
        }
        if (_canViewContractors) accessibleRoutes.Add("/hr/contractors");
        if (_canViewAttendance) accessibleRoutes.Add("/hr/attendance");
        if (_canViewShifts) accessibleRoutes.Add("/hr/shifts");
        if (_canViewLeave) accessibleRoutes.Add("/hr/leave");
        if (_canViewPayroll) accessibleRoutes.Add("/hr/payroll");

        if (accessibleRoutes.Count == 1)
        {
            Navigation.NavigateTo(accessibleRoutes[0], forceLoad: false, replace: true);
            return;
        }

        _ready = true;

        if (_canViewContractors)
        {
            await LoadContractorCountAsync();
        }
    }

    private async Task LoadContractorCountAsync()
    {
        _contractorLoading = true;
        _contractorLoadFailed = false;

        try
        {
            var contractors = await ContractorService.GetContractorsAsync();
            _contractorCount = contractors.Count;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the contractor count for the HR dashboard.");
            _contractorLoadFailed = true;
        }
        finally
        {
            _contractorLoading = false;
        }
    }

    private void OpenCompanyEmployees() => Navigation.NavigateTo("/hr/employees/company");
    private void OpenSiteEmployees() => Navigation.NavigateTo("/hr/employees/site");
    private void OpenContractors() => Navigation.NavigateTo("/hr/contractors");
    private void OpenAttendance() => Navigation.NavigateTo("/hr/attendance");
    private void OpenSiteAssignments() => Navigation.NavigateTo("/hr/site-assignments");
    private void OpenLeave() => Navigation.NavigateTo("/hr/leave");
    private void OpenShifts() => Navigation.NavigateTo("/hr/shifts");
    private void OpenTimesheets() => Navigation.NavigateTo("/hr/timesheets");
    private void OpenPayroll() => Navigation.NavigateTo("/hr/payroll");
}
