@page "/users/create"

@using CSM.Web.Models.Users
@using CSM.Web.Models.Sites
@using CSM.Web.Models.HRM
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject IEmployeeService EmployeeService
@inject UserWebService UserService
@inject NavigationManager Navigation

<h3 class="mb-4">Create User</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EditForm Model="model" OnValidSubmit="SaveAsync">

    <DataAnnotationsValidator/>

    <ValidationSummary/>

    <div class="row g-3">

        <div class="col-md-6">
            <label>Email</label>
            <InputText class="form-control"
                       @bind-Value="model.Email"/>
        </div>

        <div class="col-md-6">
            <label>Temporary Password</label>
            <InputText class="form-control"
                       @bind-Value="model.TemporaryPassword"/>
        </div>

        <div class="col-md-6">
            <label>First Name</label>
            <InputText class="form-control"
                       @bind-Value="model.FirstName"/>
        </div>

        <div class="col-md-6">
            <label>Last Name</label>
            <InputText class="form-control"
                       @bind-Value="model.LastName"/>
        </div>

        <div class="col-md-6">
            <label>Phone</label>
            <InputText class="form-control"
                       @bind-Value="model.PhoneNumber"/>
        </div>

        <div class="col-md-6">
            <label>Job Title</label>
            <InputText class="form-control"
                       @bind-Value="model.JobTitle"/>
        </div>

        @if (model.Roles.Contains("Employee", StringComparer.OrdinalIgnoreCase))
        {
            <div class="col-md-6">
                <label class="form-label">Link Employee *</label>

                <InputSelect class="form-select"
                             @bind-Value="model.EmployeeId">
                    <option value="">-- Select Employee --</option>

                    @foreach (var employee in Employees)
                    {
                        <option value="@employee.Id">
                            @employee.EmployeeNumber -
                            @employee.FirstName
                            @(string.IsNullOrWhiteSpace(employee.MiddleName)
                                ? ""
                                : $" {employee.MiddleName}")
                            @employee.LastName
                        </option>
                    }
                </InputSelect>

                @if (Employees.Count == 0)
                {
                    <div class="text-danger small mt-1">
                        No employees are available for this company.
                    </div>
                }
            </div>
        }

    </div>

    <hr/>

    <h5>Roles</h5>

    @foreach (var role in Roles)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@model.Roles.Contains(role)"
                   @onchange="e => ToggleRole(role, e.Value)"/>

            <label class="form-check-label">@role</label>
        </div>
    }

    <hr/>

    <h5>Construction Site Access</h5>

    @foreach (var site in Sites)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@model.SiteIds.Contains(site.Id)"
                   @onchange="e => ToggleSite(site.Id, e.Value)" />

            <label class="form-check-label">
                @site.Name
            </label>
        </div>
    }

    <div class="mt-3">
        <label>Default Site</label>

        <InputSelect class="form-select"
                     @bind-Value="model.DefaultSiteId">

            <option value="">-- Select Default Site --</option>

            @foreach (var site in SelectedSites)
            {
                <option value="@site.Id">
                    @site.Name
                </option>
            }

        </InputSelect>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary"
                disabled="@saving">
            Create User
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Back">
            Cancel
        </button>
    </div>

</EditForm>

@code {
    private readonly CreateUserModel model = new();

    private bool saving;

    private string? errorMessage;

    private List<SiteResponse> Sites = [];
    private List<EmployeeResponse> Employees = [];


private readonly string[] Roles =
{
    // Official roles
    "Administrator",
    "ProjectManager",
    "SiteEngineer",
    "Storekeeper",
    "ProcurementOfficer",
    "FinanceOfficer",
    "HrOfficer",
    "EquipmentManager",
    "SafetyOfficer",
    "SiteManager",
    "Accountant",

    // Legacy roles retained for compatibility
    "CompanyAdmin",
    "Supervisor",
    "HROfficer",
    "Employee"
};


    private IEnumerable<SiteResponse> SelectedSites =>
        Sites.Where(x => model.SiteIds.Contains(x.Id));

    protected override async Task OnInitializedAsync()
    {
        var permissions = await AuthService.GetPermissionsAsync();

        if (permissions.Contains("Sites_View"))
        {
            Sites = await ProjectService.GetSitesAsync();
        }

        var companyId = await AuthService.GetCurrentCompanyIdAsync();

        if (!companyId.HasValue)
        {
            return;
        }

        Employees = (await EmployeeService.GetEmployeesAsync())
            .Where(x => x.CompanyId == companyId.Value)
            .OrderBy(x => x.EmployeeNumber)
            .ToList();
    }

    private void ToggleRole(string role, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.Roles.Contains(role))
                model.Roles.Add(role);
        }
        else
        {
            model.Roles.Remove(role);
        }
    }

    private void ToggleSite(Guid siteId, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.SiteIds.Contains(siteId))
                model.SiteIds.Add(siteId);
        }
        else
        {
            model.SiteIds.Remove(siteId);

            if (model.DefaultSiteId == siteId)
                model.DefaultSiteId = null;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;

        try
        {
            var companyId = await AuthService.GetCurrentCompanyIdAsync();

            if (model.Roles.Contains(
                    "Employee",
                    StringComparer.OrdinalIgnoreCase))
            {
                if (!model.EmployeeId.HasValue)
                {
                    errorMessage =
                        "Select an employee before creating an Employee account.";
                    return;
                }

                var selectedEmployee = Employees.FirstOrDefault(
                    x => x.Id == model.EmployeeId.Value);

                if (selectedEmployee is null)
                {
                    errorMessage =
                        "The selected employee could not be found.";
                    return;
                }

                // Company users must use their own company.
                if (companyId.HasValue &&
                    selectedEmployee.CompanyId != companyId.Value)
                {
                    errorMessage =
                        "The selected employee does not belong to your company.";
                    return;
                }

                // SuperAdmin has no company, so derive it from the
                // employee being linked.
                if (!companyId.HasValue)
                {
                    companyId = selectedEmployee.CompanyId;
                }

                model.CompanyId = companyId.Value;
            }
            else
            {
                if (!companyId.HasValue)
                {
                    errorMessage =
                        "A company must be selected for this user.";
                    return;
                }

                model.CompanyId = companyId.Value;
                model.EmployeeId = null;
            }

            await UserService.CreateAsync(model);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users");
    }
}