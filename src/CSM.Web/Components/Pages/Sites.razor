@page "/sites-management"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Construction Sites</PageTitle>

@if (_loading)
{
    <div class="container py-4">
        <h4>Loading construction sites...</h4>
    </div>
}
else
{
    <main class="sites-page container-fluid">
        <header class="sites-header">
            <div class="sites-heading">
                <span class="sites-eyebrow">PROJECT DIRECTORY</span>
                <h1>Construction Sites</h1>
                <p>Manage and monitor your company construction sites.</p>
            </div>

            <div class="sites-header-actions">
                <button type="button" class="btn sites-back-button" @onclick="Back">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    <span>Back</span>
                </button>
                <button type="button" class="btn sites-create-button" @onclick="NewSite">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>New site</span>
                </button>
            </div>
        </header>

        <section class="sites-statistics" aria-label="Site status summary">
            <article class="site-stat-card">
                <span class="site-stat-icon stat-total"><i class="bi bi-buildings" aria-hidden="true"></i></span>
                <div><span class="site-stat-label">Total sites</span><strong>@_sites.Count</strong></div>
            </article>
            <article class="site-stat-card">
                <span class="site-stat-icon stat-active"><i class="bi bi-activity" aria-hidden="true"></i></span>
                <div><span class="site-stat-label">Active</span><strong>@_sites.Count(x => x.Status == "Active")</strong></div>
            </article>
            <article class="site-stat-card">
                <span class="site-stat-icon stat-planning"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
                <div><span class="site-stat-label">Planning</span><strong>@_sites.Count(x => x.Status == "Planning")</strong></div>
            </article>
            <article class="site-stat-card">
                <span class="site-stat-icon stat-completed"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
                <div><span class="site-stat-label">Completed</span><strong>@_sites.Count(x => x.Status == "Completed")</strong></div>
            </article>
        </section>

        <section class="sites-filter-panel" aria-label="Search and filter sites">
            <label class="site-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input class="form-control"
                       aria-label="Search sites"
                       placeholder="Search by site name or code..."
                       @bind="_search" />
            </label>
            <label class="site-status-filter">
                <span class="filter-label">Status</span>
                <select class="form-select" aria-label="Filter sites by status" @bind="_statusFilter">
                    <option value="">All statuses</option>
                    <option>Planning</option>
                    <option>Active</option>
                    <option>OnHold</option>
                    <option>Completed</option>
                    <option>Closed</option>
                </select>
            </label>
            <span class="sites-result-count">@FilteredSites.Count() @(FilteredSites.Count() == 1 ? "site" : "sites")</span>
        </section>

        @if (!FilteredSites.Any())
        {
            <section class="sites-empty-state">
                <span class="sites-empty-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <h2>@(_sites.Count == 0 ? "No sites yet" : "No matching sites")</h2>
                <p>@(_sites.Count == 0
                    ? "Create your first construction site to get started."
                    : "Try changing your search or selecting a different status.")</p>
                @if (_sites.Count == 0)
                {
                    <button type="button" class="btn sites-create-button" @onclick="NewSite">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Create a site</span>
                    </button>
                }
            </section>
        }
        else
        {
            <section class="sites-grid" aria-label="Construction sites">
                @foreach (var site in FilteredSites)
                {
                    <article class="site-card">
                        <div class="site-card-body">
                            <div class="site-card-heading">
                                <div class="site-title-group">
                                    <h2>@site.Name</h2>
                                    <span class="site-code"><i class="bi bi-hash" aria-hidden="true"></i>@site.SiteCode</span>
                                </div>
                                <span class="@StatusBadge(site.Status) site-status-badge">@StatusLabel(site.Status)</span>
                            </div>

                            <div class="site-details">
                                <div class="site-detail">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                    <span><strong>City</strong>@(string.IsNullOrWhiteSpace(site.City) ? "—" : site.City)</span>
                                </div>
                                <div class="site-detail">
                                    <i class="bi bi-map" aria-hidden="true"></i>
                                    <span><strong>Region</strong>@(string.IsNullOrWhiteSpace(site.Region) ? "—" : site.Region)</span>
                                </div>
                                <div class="site-detail">
                                    <i class="bi bi-globe2" aria-hidden="true"></i>
                                    <span><strong>Country</strong>@(string.IsNullOrWhiteSpace(site.Country) ? "—" : site.Country)</span>
                                </div>
                                <div class="site-detail">
                                    <i class="bi bi-calendar-event" aria-hidden="true"></i>
                                    <span><strong>Planned start</strong>@(site.PlannedStartDate?.ToString("dd MMM yyyy") ?? "Not scheduled")</span>
                                </div>
                            </div>
                        </div>

                        <footer class="site-card-actions">
                            <button type="button"
                                    class="btn site-view-button"
                                    aria-label="@($"View {site.Name}")"
                                    @onclick="() => ViewSite(site.Id)">
                                <i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>
                                <span>View site</span>
                            </button>
                            <button type="button"
                                    class="btn site-edit-button"
                                    aria-label="@($"Edit {site.Name}")"
                                    @onclick="() => EditSite(site.Id)">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                <span>Edit</span>
                            </button>
                        </footer>
                    </article>
                }
            </section>
        }
    </main>
}

@code {
    private List<SiteResponse> _sites = [];
    private bool _loading = true;
    private bool _loaded;

    private string _search = "";
    private string _statusFilter = "";

    private IEnumerable<SiteResponse> FilteredSites =>
        _sites.Where(site =>
            (string.IsNullOrWhiteSpace(_search) ||
             site.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             site.SiteCode.Contains(_search, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(_statusFilter) ||
             string.Equals(site.Status, _statusFilter, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        _sites = await ProjectService.GetSitesAsync();

        _loading = false;

        StateHasChanged();
    }

    void OpenSite(Guid siteId)
    {
        Navigation.NavigateTo($"/sites/{siteId}");
    }

    private static string StatusBadge(string status) => status switch
    {
        "Active" => "badge bg-success",
        "Completed" => "badge bg-primary",
        "Planning" => "badge bg-info text-dark",
        "OnHold" => "badge bg-warning text-dark",
        "Closed" => "badge bg-secondary",
        _ => "badge bg-light text-dark"
    };

    private static string StatusLabel(string status) => status switch
    {
        "OnHold" => "On hold",
        _ => status
    };

    private void Back()
    {
        Navigation.NavigateTo("/");
    }

    private void NewSite()
    {
        Navigation.NavigateTo("/sites/create");
    }

    private void ViewSite(Guid id)
    {
        Navigation.NavigateTo($"/sites/{id}");
    }

    private void EditSite(Guid id)
    {
        Navigation.NavigateTo($"/sites/edit/{id}");
    }

    private void OpenCompanyCostCodes()
    {
        Navigation.NavigateTo("/finance/company/cost-codes");
    }

    private void OpenCompanyVendors()
    {
        Navigation.NavigateTo("/finance/company/vendors");
    }

    private void OpenCompanyInvoices()
    {
        Navigation.NavigateTo("/finance/company/invoices");
    }

    private void OpenCompanyPayments()
    {
        Navigation.NavigateTo("/finance/company/payments");
    }
}