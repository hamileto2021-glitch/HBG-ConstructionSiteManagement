
@page "/material-requests/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<PageTitle>Material Request Details</PageTitle>

<style>
    .material-request-action {
        width: 180px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        flex-shrink: 0;
    }
</style>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
}
else if (request is null)
{
    <div class="container py-4">
        <div class="alert alert-warning">
            Material Request not found.
        </div>

        <button class="btn btn-secondary" @onclick="Back">
            Back
        </button>
    </div>
}
else
{
    <div class="container py-4">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <button class="btn btn-outline-secondary mb-3"
                @onclick="Back">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h2>@request.RequestNumber</h2>
                <div class="text-muted">@request.SiteName</div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-primary">@request.Status</span>

                @if (string.Equals(request.Status, "Draft",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <PermissionView AnyOf="@MaterialRequestSubmitPermission">
                        <button class="btn btn-success material-request-action"
                                @onclick="SubmitForApproval"
                                disabled="@submitting">
                            @(submitting ? "Submitting..." : "Submit for Approval")
                        </button>

                        <button class="btn btn-outline-primary material-request-action"
                                @onclick="EditRequest">
                            Edit Request
                        </button>
                    </PermissionView>
                }

                @if (string.Equals(request.Status, "Submitted",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <PermissionView AnyOf="@MaterialRequestApprovePermission">
                        <button class="btn btn-success material-request-action"
                                @onclick="ApproveRequest"
                                disabled="@processing">
                            @(processing ? "Processing..." : "Approve")
                        </button>

                        <div style="width: 220px;">
                            <input class="form-control"
                                   placeholder="Reason for rejection (required)"
                                   @bind="rejectionRemarks"
                                   disabled="@processing" />
                        </div>

                        <button class="btn btn-danger material-request-action"
                                @onclick="RejectRequest"
                                disabled="@processing">
                            Reject
                        </button>
                    </PermissionView>
                }

                @if (string.Equals(request.Status, "Rejected",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <PermissionView AnyOf="@MaterialRequestSubmitPermission">
                        <button class="btn btn-outline-secondary material-request-action"
                                @onclick="MakeDraft"
                                disabled="@processing">
                            @(processing ? "Processing..." : "Make Draft")
                        </button>
                    </PermissionView>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Request Information</h5>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Requested By</div>
                        <div class="fw-semibold">@request.RequestedByName</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Request Date</div>
                        <div class="fw-semibold">
                            @request.RequestDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Priority</div>
                        <div class="fw-semibold">@request.Priority</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Required By</div>
                        <div class="fw-semibold">
                            @(request.RequiredByDate?.ToString("dd MMM yyyy") ?? "-")
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted small">Purpose</div>
                        <div>
                            @(string.IsNullOrWhiteSpace(request.Purpose)
                                ? "-"
                                : request.Purpose)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Requested Materials</h5>
            </div>

            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Material</th>
                            <th>Unit</th>
                            <th class="text-end">Requested Qty</th>
                            <th class="text-end">Approved Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in request.Lines)
                        {
                            <tr @key="line.Id">
                                <td>@line.MaterialName</td>
                                <td>@line.UnitOfMeasure</td>
                                <td class="text-end">@line.RequestedQuantity</td>

                                <td style="min-width: 140px;">
                                    @if (string.Equals(request.Status, "Submitted",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <input type="number"
                                               class="form-control form-control-sm text-end"
                                               min="0"
                                               max="@line.RequestedQuantity"
                                               step="0.01"
                                               @bind="line.ApprovedQuantity"
                                               disabled="@processing" />
                                    }
                                    else
                                    {
                                        <div class="text-end">
                                            @line.ApprovedQuantity
                                        </div>
                                    }
                                </td>

                                <td>@line.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] MaterialRequestSubmitPermission =
        ["Procurement_MaterialRequest_Submit"];
    private static readonly string[] MaterialRequestApprovePermission =
        ["Procurement_MaterialRequest_Approve"];

    [Parameter]
    public Guid Id { get; set; }

    private bool loading = true;
    private bool submitting;
    private bool processing;

    private MaterialRequestResponse? request;
    private string? errorMessage;
    private string rejectionRemarks = string.Empty;

    private async Task LoadRequestAsync()
    {
        request = await ProcurementService.GetMaterialRequestAsync(Id);
    }

    private async Task SubmitForApproval()
    {
        submitting = true;
        errorMessage = null;

        try
        {
            await ProcurementService.SubmitMaterialRequestAsync(Id);
            await LoadRequestAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private void EditRequest()
    {
        Navigation.NavigateTo($"/material-requests/edit/{Id}");
    }

    private async Task ApproveRequest()
    {
        if (request is null)
            return;

        processing = true;
        errorMessage = null;

        try
        {
            var lines = request.Lines.Select(line =>
                new MaterialRequestApprovalLine
                {
                    MaterialRequestLineId = line.Id,
                    ApprovedQuantity = line.ApprovedQuantity
                }).ToList();

            if (lines.Count == 0)
            {
                errorMessage = "The request has no material lines to approve.";
                return;
            }

            if (request.Lines.Any(line =>
                line.ApprovedQuantity < 0 ||
                line.ApprovedQuantity > line.RequestedQuantity))
            {
                errorMessage =
                    "Each approved quantity must be between zero and the requested quantity.";
                return;
            }

            await ProcurementService.ApproveMaterialRequestAsync(
                Id,
                new ApproveMaterialRequestRequest
                {
                    Lines = lines
                });

            await LoadRequestAsync();

            if (request is null)
                errorMessage =
                    "Approval succeeded, but the request could not be reloaded.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            processing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RejectRequest()
    {
        if (request is null)
            return;

        if (string.IsNullOrWhiteSpace(rejectionRemarks))
        {
            errorMessage = "Enter a reason for rejecting this request.";
            return;
        }

        processing = true;
        errorMessage = null;

        try
        {
            await ProcurementService.RejectMaterialRequestAsync(
                Id,
                new MaterialRequestRemarksRequest
                {
                    Remarks = rejectionRemarks.Trim()
                });

            await LoadRequestAsync();
            rejectionRemarks = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            processing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MakeDraft()
    {
        processing = true;
        errorMessage = null;

        try
        {
            await ProcurementService.MakeMaterialRequestDraftAsync(Id);
            await LoadRequestAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            processing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRequestAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void Back()
    {
        if (request is null)
        {
            Navigation.NavigateTo("/material-requests");
            return;
        }

        Navigation.NavigateTo(
            $"/material-requests/site/{request.ConstructionSiteId}");
    }
}
