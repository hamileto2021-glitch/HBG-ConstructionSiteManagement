@page "/finance/company/payments"
@rendermode InteractiveServer

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Company Payments</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-success"></div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="container py-4">
        <div class="alert alert-warning" role="alert">
            @_error
        </div>
        <button class="btn btn-outline-secondary" @onclick="Back">
            Back to Finance
        </button>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <button class="btn btn-outline-secondary mb-2"
                        @onclick="Back">
                    ← Finance
                </button>

                <h2 class="mb-0">Company Payments</h2>

                <div class="text-muted">
                    Head Office Payments
                </div>
            </div>

            @if (_canManagePayments)
            {
                <button class="btn btn-success"
                        @onclick="CreatePayment">
                    + New Payment
                </button>
            }

        </div>

        @if (_items.Count == 0)
        {
            <div class="alert alert-info">
                No company payments found.
            </div>
        }
        else
        {
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Payment #</th>
                        <th>Date</th>
                        <th>Invoice</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr style="cursor:pointer"
                            @onclick="() => Open(item.Id)">

                            <td>@item.PaymentNumber</td>

                            <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>

                            <td>@item.InvoiceNumber</td>

                            <td>@($"{item.CurrencyCode} {item.Amount:N2}")</td>

                            <td>
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
}

@code {

    private bool _loading = true;
    private bool _canManagePayments;
    private string? _error;

    private List<PaymentResponse> _items = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var permissions = await AuthService.GetPermissionsAsync();
            if (!permissions.Contains("Finance_Payment_View"))
            {
                _error = "You do not have permission to view payments.";
                return;
            }

            _canManagePayments =
                permissions.Contains("Finance_Payment_Manage");
            _items = await FinanceService.GetCompanyPaymentsAsync();
        }
        catch (HttpRequestException ex) when (
            ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _error = "You do not have access to company-level payments. Contact your administrator if you need this access.";
        }
        catch (HttpRequestException)
        {
            _error = "Payments could not be loaded right now. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }

    private void Open(Guid id)
    {
        Navigation.NavigateTo($"/finance/payments/{id}");
    }

    private void CreatePayment()
    {
        Navigation.NavigateTo("/finance/payments/create");
    }

}