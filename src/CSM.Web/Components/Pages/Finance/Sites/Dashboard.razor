@page "/finance/sites"
@rendermode InteractiveServer

@using System.Net
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Finance | CSM</PageTitle>

<main class="finance-sites-page">
    <header class="finance-sites-header">
        <div>
            <div class="finance-sites-eyebrow">
                <i class="bi bi-wallet2" aria-hidden="true"></i>
                Financial workspace
            </div>
            <h1>Finance</h1>
            <p>@(_hasActiveSiteAssignment ? "Open financial records for your assigned construction sites." : "Manage company finances or open financial records for a construction site.")</p>
        </div>

        <button type="button" class="finance-back-button" @onclick="Back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Dashboard</span>
        </button>
    </header>

    @if (_loading)
    {
        <section class="finance-loading" role="status" aria-live="polite" aria-busy="true">
            <div class="finance-skeleton-company" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
            <div class="finance-skeleton-heading" aria-hidden="true"></div>
            <div class="finance-skeleton-sites" aria-hidden="true">
                @for (var index = 0; index < 3; index++)
                {
                    <div class="finance-skeleton-site"></div>
                }
            </div>
            <span class="visually-hidden">Loading finance workspace…</span>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <section class="finance-error" role="alert">
                <span class="finance-error-icon" aria-hidden="true">
                    <i class="bi bi-exclamation-triangle"></i>
                </span>
                <div>
                    <h2>Site finance is unavailable</h2>
                    <p>@_error</p>
                </div>
                <button type="button" class="finance-retry-button" @onclick="LoadAsync" disabled="@_loading">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    Try again
                </button>
            </section>
        }

        @if (!_hasActiveSiteAssignment)
        {
        <section class="company-finance-panel" aria-labelledby="company-finance-title">
            <div class="company-finance-heading">
                <span class="company-finance-icon" aria-hidden="true">
                    <i class="bi bi-buildings"></i>
                </span>
                <div>
                    <div class="finance-section-eyebrow">ORGANIZATION</div>
                    <h2 id="company-finance-title">Company finance</h2>
                    <p>Company-wide financial records and shared resources.</p>
                </div>
            </div>

            <div class="company-finance-grid" aria-label="Company finance options">
                    @if (Can("Finance_CostCode_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyCostCodes">
                            <span class="company-link-icon company-tone-indigo"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                            <span><strong>Cost codes</strong><small>Manage shared cost categories</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
                    <button class="company-finance-link" type="button" @onclick="OpenCompanyVendors">
                        <span class="company-link-icon company-tone-blue"><i class="bi bi-people" aria-hidden="true"></i></span>
                        <span><strong>Vendors</strong><small>View supplier records</small></span>
                        <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                    </button>
                    @if (Can("Finance_Budget_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyBudgets">
                            <span class="company-link-icon company-tone-green"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                            <span><strong>Budgets</strong><small>Review company budgets</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
                    @if (Can("Finance_Invoice_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyInvoices">
                            <span class="company-link-icon company-tone-violet"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                            <span><strong>Invoices</strong><small>Manage company invoices</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
                    @if (Can("Finance_Payment_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyPayments">
                            <span class="company-link-icon company-tone-cyan"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
                            <span><strong>Payments</strong><small>Review payment records</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
                    @if (Can("Finance_Expense_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyExpenses">
                            <span class="company-link-icon company-tone-orange"><i class="bi bi-currency-dollar" aria-hidden="true"></i></span>
                            <span><strong>Expenses</strong><small>Track company expenses</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
                    @if (Can("Finance_PettyCash_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyPettyCash">
                            <span class="company-link-icon company-tone-teal"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                            <span><strong>Petty cash</strong><small>Manage cash accounts</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
                    @if (Can("Reports_FinancialSummary_View"))
                    {
                        <button class="company-finance-link" type="button" @onclick="OpenCompanyFinancialSummary">
                            <span class="company-link-icon company-tone-indigo"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span>
                            <span><strong>Financial summary</strong><small>View consolidated reporting</small></span>
                            <i class="bi bi-chevron-right company-link-arrow" aria-hidden="true"></i>
                        </button>
                    }
            </div>
        </section>
        }

        <section class="site-finance-section" aria-labelledby="site-finance-title">
            <div class="site-section-heading">
                <div>
                    <div class="finance-section-eyebrow">PROJECTS</div>
                    <h2 id="site-finance-title">Site finance</h2>
                    <p>Choose a construction site to view its financial records.</p>
                </div>

                @if (_sites.Count > 0)
                {
                    <div class="site-count">
                        <strong>@_sites.Count</strong>
                        <span>@(_sites.Count == 1 ? "site" : "sites")</span>
                    </div>
                }
            </div>

            @if (_error is not null)
            {
                <div class="site-list-unavailable">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <span>The site list could not be loaded. @(_hasActiveSiteAssignment ? "Assigned site finance is unavailable until the site list can be loaded." : "Company finance options remain available above.")</span>
                </div>
            }
            else if (_sites.Count == 0)
            {
                <div class="finance-empty-state">
                    <span class="finance-empty-icon" aria-hidden="true">
                        <i class="bi bi-geo-alt"></i>
                    </span>
                    <h3>No construction sites found</h3>
                    <p>There are currently no sites available for site-level finance.</p>
                </div>
            }
            else
            {
                <div class="site-filter-panel">
                    <label class="site-search-field">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span class="visually-hidden">Search construction sites</span>
                        <input type="search"
                               placeholder="Search by site, code, or location"
                               @bind="_search"
                               @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <button type="button"
                                    class="site-search-clear"
                                    @onclick="ClearSearch"
                                    aria-label="Clear site search">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        }
                    </label>
                    <label class="site-status-filter">
                        <span class="visually-hidden">Filter sites by status</span>
                        <select class="form-select" @bind="_statusFilter">
                            <option value="">All statuses</option>
                            @foreach (var status in AvailableStatuses)
                            {
                                <option value="@status">@GetDisplayStatus(status)</option>
                            }
                        </select>
                    </label>
                </div>

                @if (!FilteredSites.Any())
                {
                    <div class="finance-empty-state finance-filter-empty">
                        <span class="finance-empty-icon" aria-hidden="true">
                            <i class="bi bi-search"></i>
                        </span>
                        <h3>No matching sites</h3>
                        <p>Try another search term or status filter.</p>
                        <button type="button" class="finance-text-button" @onclick="ClearFilters">
                            Clear filters
                        </button>
                    </div>
                }
                else
                {
                    <div class="site-finance-grid">
                        @foreach (var site in FilteredSites)
                        {
                            <article class="site-finance-card">
                                <div class="site-card-heading">
                                    <span class="site-card-icon" aria-hidden="true">
                                        <i class="bi bi-building"></i>
                                    </span>
                                    <span class="site-status-badge @GetStatusClass(site.Status)">
                                        @GetDisplayStatus(site.Status)
                                    </span>
                                </div>

                                <div class="site-card-title-row">
                                    <div>
                                        <h3>@site.Name</h3>
                                        <span class="site-card-code">@site.SiteCode</span>
                                    </div>
                                </div>

                                <div class="site-card-location">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                    <span>@SiteLocation(site)</span>
                                </div>

                                <div class="site-card-actions" aria-label="@($"{site.Name} finance sections")">
                                    @if (Can("Finance_CostCode_View"))
                                    {
                                        <button type="button" @onclick="() => OpenCostCodes(site.Id)">
                                            <i class="bi bi-diagram-3" aria-hidden="true"></i><span>Cost codes</span>
                                        </button>
                                    }
                                    @if (Can("Finance_Budget_View"))
                                    {
                                        <button type="button" @onclick="() => OpenBudgets(site.Id)">
                                            <i class="bi bi-cash-stack" aria-hidden="true"></i><span>Budgets</span>
                                        </button>
                                    }
                                    @if (Can("Finance_Invoice_View"))
                                    {
                                        <button type="button" @onclick="() => OpenInvoices(site.Id)">
                                            <i class="bi bi-receipt" aria-hidden="true"></i><span>Invoices</span>
                                        </button>
                                    }
                                    @if (Can("Finance_Payment_View"))
                                    {
                                        <button type="button" @onclick="() => OpenPayments(site.Id)">
                                            <i class="bi bi-wallet2" aria-hidden="true"></i><span>Payments</span>
                                        </button>
                                    }
                                    @if (Can("Finance_Expense_View"))
                                    {
                                        <button type="button" @onclick="() => OpenExpenses(site.Id)">
                                            <i class="bi bi-currency-dollar" aria-hidden="true"></i><span>Expenses</span>
                                        </button>
                                    }
                                    @if (Can("Finance_PettyCash_View"))
                                    {
                                        <button type="button" @onclick="() => OpenPettyCash(site.Id)">
                                            <i class="bi bi-cash-coin" aria-hidden="true"></i><span>Petty cash</span>
                                        </button>
                                    }
                                    @if (!HasSiteFinanceOptions)
                                    {
                                        <span class="site-no-actions">No finance sections available for your account.</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>
    }
</main>

@code {
    private List<SiteResponse> _sites = [];
    private HashSet<string> _permissions = [];
    private bool _hasActiveSiteAssignment;
    private bool _loading = true;
    private bool _loaded;
    private string? _error;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;

    private bool HasSiteFinanceOptions =>
        Can("Finance_CostCode_View") ||
        Can("Finance_Budget_View") ||
        Can("Finance_Invoice_View") ||
        Can("Finance_Payment_View") ||
        Can("Finance_Expense_View") ||
        Can("Finance_PettyCash_View");

    private IEnumerable<string> AvailableStatuses =>
        _sites
            .Select(site => site.Status)
            .Where(status => !string.IsNullOrWhiteSpace(status))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(status => status, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<SiteResponse> FilteredSites =>
        _sites
            .Where(site =>
                (string.IsNullOrWhiteSpace(_search) ||
                 Contains(site.Name, _search) ||
                 Contains(site.SiteCode, _search) ||
                 Contains(site.City, _search) ||
                 Contains(site.Region, _search) ||
                 Contains(site.Address, _search)) &&
                (string.IsNullOrWhiteSpace(_statusFilter) ||
                 string.Equals(site.Status, _statusFilter, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(site => site.Name, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
        {
            return;
        }

        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _permissions = (await AuthService.GetPermissionsAsync()).ToHashSet();
            var scope = await AuthService.GetCurrentUserScopeAsync();
            _hasActiveSiteAssignment = scope.HasActiveSiteAccess;
            _sites = await ProjectService.GetSitesAsync();
        }
        catch (HttpRequestException exception)
            when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            Logger.LogWarning(exception, "Access denied while loading finance sites.");
            _error = "You don't have permission to view construction sites.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the finance sites workspace.");
            _error = $"Failed to load sites: {exception.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool Can(string permission) => _permissions.Contains(permission);

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string SiteLocation(SiteResponse site)
    {
        var location = new[] { site.City, site.Region }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var locality = string.Join(", ", location);

        return string.IsNullOrWhiteSpace(locality)
            ? Display(site.Address)
            : locality;
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Location not provided" : value;

    private static string GetDisplayStatus(string? status) =>
        string.Equals(status, "OnHold", StringComparison.OrdinalIgnoreCase)
            ? "On hold"
            : string.IsNullOrWhiteSpace(status) ? "Unknown" : status;

    private static string GetStatusClass(string? status) =>
        status?.ToLowerInvariant() switch
        {
            "active" => "site-status-active",
            "planning" => "site-status-planning",
            "onhold" => "site-status-onhold",
            "completed" => "site-status-completed",
            "closed" => "site-status-closed",
            _ => "site-status-default"
        };

    private void ClearSearch() => _search = string.Empty;

    private void ClearFilters()
    {
        _search = string.Empty;
        _statusFilter = string.Empty;
    }

    private void Back() => Navigation.NavigateTo("/dashboard");
    private void OpenCostCodes(Guid siteId) => Navigation.NavigateTo($"/finance/sites/{siteId}/cost-codes");
    private void OpenBudgets(Guid siteId) => Navigation.NavigateTo($"/finance/sites/{siteId}/budgets");
    private void OpenInvoices(Guid siteId) => Navigation.NavigateTo($"/finance/sites/{siteId}/invoices");
    private void OpenPayments(Guid siteId) => Navigation.NavigateTo($"/finance/sites/{siteId}/payments");
    private void OpenExpenses(Guid siteId) => Navigation.NavigateTo($"/finance/sites/{siteId}/expenses");
    private void OpenPettyCash(Guid siteId) => Navigation.NavigateTo($"/finance/petty-cash/site/{siteId}");
    private void OpenCompanyCostCodes() => Navigation.NavigateTo("/finance/company/cost-codes");
    private void OpenCompanyVendors() => Navigation.NavigateTo("/finance/company/vendors");
    private void OpenCompanyBudgets() => Navigation.NavigateTo("/finance/company/budgets");
    private void OpenCompanyInvoices() => Navigation.NavigateTo("/finance/company/invoices");
    private void OpenCompanyPayments() => Navigation.NavigateTo("/finance/company/payments");
    private void OpenCompanyExpenses() => Navigation.NavigateTo("/finance/company/expenses");
    private void OpenCompanyPettyCash() => Navigation.NavigateTo("/finance/petty-cash");
    private void OpenCompanyFinancialSummary() => Navigation.NavigateTo("/finance/summary");
}
