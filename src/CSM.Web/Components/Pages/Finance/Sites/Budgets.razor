@page "/finance/sites/{SiteId:guid}/budgets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net
@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Site Budgets</PageTitle>

<PageHeader Title="Site budgets"
            Description="Review and manage budgets for this construction site.">
    <Actions>
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="Back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back to sites
        </button>

        @if (_canManage)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="Create">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                New budget
            </button>
        }
    </Actions>
</PageHeader>

<AsyncContent IsLoading="_loading"
              Error="_error"
              IsEmpty="@(!_loading && string.IsNullOrWhiteSpace(_error) && _items.Count == 0)"
              LoadingText="Loading budgets..."
              ErrorTitle="Budgets could not be loaded"
              RetryText="Retry"
              OnRetry="LoadAsync"
              EmptyTitle="No budgets yet"
              EmptyDescription="Create a budget to start tracking this site's planned costs."
              EmptyIconClass="bi bi-wallet2">
    <EmptyActions>
        @if (_canManage)
        {
            <button type="button"
                    class="btn btn-primary"
                    @onclick="Create">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Create budget
            </button>
        }
    </EmptyActions>

    <ChildContent>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Budget no.</th>
                        <th scope="col">Name</th>
                        <th scope="col">Project</th>
                        <th scope="col">Total</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <th scope="row">@item.BudgetNumber</th>
                        <td>@item.Name</td>
                        <td>@item.ProjectName</td>
                        <td>@($"{item.CurrencyCode} {item.TotalAmount:N2}")</td>
                        <td>
                            <StatusBadge Label="@item.Status"
                                         Tone="@GetStatusTone(item.Status)" />
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    aria-label="@($"Open budget {item.BudgetNumber}")"
                                    @onclick="() => Open(item.Id)">
                                Open
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </ChildContent>
</AsyncContent>

@code {
    [Parameter] public Guid SiteId { get; set; }

    private bool _loading = true;
    private bool _canManage;
    private string? _error;
    private List<BudgetResponse> _items = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var permissions = await AuthService.GetPermissionsAsync();

            _canManage = permissions.Contains("Finance_Budget_Manage");

            if (!permissions.Contains("Finance_Budget_View"))
            {
                _error = "You don't have permission to view budgets.";
                return;
            }

            _items = (await FinanceService.GetSiteBudgetsAsync(SiteId)).ToList();
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            // The API refuses either because the role lacks the budget
            // permission or because the user is not assigned to this site.
            _error = "You can't view budgets for this site. " +
                     "Check that you are assigned to it.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load budgets: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static StatusBadgeTone GetStatusTone(string status) =>
        status.Trim().ToLowerInvariant() switch
        {
            "approved" or "completed" or "paid" => StatusBadgeTone.Success,
            "pending" or "submitted" or "under review" =>
                StatusBadgeTone.Warning,
            "rejected" or "cancelled" or "overdue" =>
                StatusBadgeTone.Danger,
            "active" or "in progress" => StatusBadgeTone.Info,
            _ => StatusBadgeTone.Neutral
        };

    void Create()
        => Navigation.NavigateTo($"/finance/sites/{SiteId}/budgets/create");

    void Open(Guid id)
        => Navigation.NavigateTo($"/finance/sites/{SiteId}/budgets/{id}");

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }
}
