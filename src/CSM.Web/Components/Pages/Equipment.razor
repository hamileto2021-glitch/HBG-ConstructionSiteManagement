@page "/equipment"

@using CSM.Web.Components.Shared
@using CSM.Web.Services

@inject NavigationManager Navigation
@inject AuthService AuthService
@inject ILogger<Equipment> Logger

<PageTitle>Equipment</PageTitle>

<div class="equipment-page container-fluid">
    <header class="equipment-header">
        <div>
            <div class="equipment-eyebrow">OPERATIONS</div>
            <h1>Equipment Management</h1>
            <p>Manage equipment, site assignments, and operational records.</p>
        </div>

        <button type="button" class="btn equipment-back-button" @onclick="GoBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Back</span>
        </button>
    </header>

    @if (_isLoading)
    {
        <section class="equipment-grid" aria-label="Loading equipment options" role="status" aria-live="polite">
            @for (var index = 0; index < 6; index++)
            {
                <div class="equipment-card-skeleton" aria-hidden="true">
                    <span class="skeleton-icon"></span>
                    <span class="skeleton-copy">
                        <span></span>
                        <span></span>
                    </span>
                </div>
            }
            <span class="visually-hidden">Loading equipment options...</span>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <section class="equipment-state equipment-error" role="alert">
            <span class="equipment-state-icon" aria-hidden="true">
                <i class="bi bi-exclamation-triangle"></i>
            </span>
            <div>
                <h2>Equipment options unavailable</h2>
                <p>@_loadError</p>
                <button type="button" class="btn equipment-retry-button" @onclick="LoadUserScopeAsync">
                    <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>
                    Try again
                </button>
            </div>
        </section>
    }
    else
    {
        <section class="equipment-grid" aria-label="Equipment management options">
            <NavigationCard Href="/equipment/list"
                            Title="Equipment"
                            Description="Register and manage equipment assets."
                            IconClass="bi bi-truck-front"
                            Tone="NavigationCardTone.Blue" />

            @if (!_isAccountant)
            {
                <NavigationCard Href="/equipment/sites"
                                Title="Assignments"
                                Description="Assign equipment to construction sites."
                                IconClass="bi bi-pin-map-fill"
                                Tone="NavigationCardTone.Indigo" />

                <NavigationCard Href="/equipment/downtime-sites"
                                Title="Downtime"
                                Description="Track equipment downtime and resolutions."
                                IconClass="bi bi-exclamation-octagon"
                                Tone="NavigationCardTone.Red" />

                <NavigationCard Href="/equipment/maintenance-sites"
                                Title="Maintenance"
                                Description="Manage preventive and corrective maintenance."
                                IconClass="bi bi-tools"
                                Tone="NavigationCardTone.Teal" />
            }

            <NavigationCard Href="/equipment/fuel-sites"
                            Title="Fuel Consumption"
                            Description="Record fuel usage by construction site."
                            IconClass="bi bi-fuel-pump"
                            Tone="NavigationCardTone.Orange" />

            @if (!_isAccountant)
            {
                <NavigationCard Href="/equipment/hourmeter-sites"
                                Title="Hour Meter"
                                Description="Record equipment operating hours by construction site."
                                IconClass="bi bi-stopwatch"
                                Tone="NavigationCardTone.Violet" />
            }

            <NavigationCard Href="/equipment/utilization-sites"
                            Title="Utilization"
                            Description="View equipment hours, fuel usage, downtime, and maintenance cost."
                            IconClass="bi bi-graph-up-arrow"
                            Tone="NavigationCardTone.Green" />

            <NavigationCard Href="/equipment/timesheet-sites"
                            Title="Daily Timesheets"
                            Description="Record daily equipment shifts by construction site."
                            IconClass="bi bi-calendar-check"
                            Tone="NavigationCardTone.Cyan" />
        </section>
    }
</div>

@code {
    private bool _isAccountant;
    private bool _isLoading = true;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadUserScopeAsync();

    private async Task LoadUserScopeAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var userScope = await AuthService.GetCurrentUserScopeAsync();

            _isAccountant = userScope.Roles.Any(role =>
                string.Equals(role, "Accountant", StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the current user's equipment access scope.");
            _loadError = "We couldn't check your access permissions. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
