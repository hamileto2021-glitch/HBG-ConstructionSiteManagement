<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <ResourcePreloader />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CSM.Web.styles.css"]" />

    <script>
        (() => {
            const themeCookie = document.cookie
                .split("; ")
                .find(value => value.startsWith("csm-theme="));
            const savedTheme = themeCookie?.split("=")[1];
            const compactCookie = document.cookie
                .split("; ")
                .find(value => value.startsWith("csm-compact="));
            const savedCompactMode = compactCookie?.split("=")[1] === "true";
            let selectedTheme = ["light", "dark", "system"].includes(savedTheme)
                ? savedTheme
                : "light";

            const applyTheme = (theme) => {
                selectedTheme = theme;
                const resolved = theme === "system"
                    ? (window.matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark" : "light")
                    : theme;

                document.documentElement.setAttribute("data-theme", resolved);
                document.documentElement.setAttribute("data-bs-theme", resolved);
            };

            window.csmTheme = {
                apply: applyTheme,
                persist: (theme) => {
                    document.cookie =
                        `csm-theme=${theme};path=/;max-age=31536000;samesite=lax`;
                    applyTheme(theme);
                },
                setCompact: (enabled) => {
                    document.documentElement.classList.toggle(
                        "csm-compact",
                        Boolean(enabled)
                    );
                },
                persistCompact: (enabled) => {
                    document.cookie =
                        `csm-compact=${Boolean(enabled)};path=/;max-age=31536000;samesite=lax`;
                    document.documentElement.classList.toggle(
                        "csm-compact",
                        Boolean(enabled)
                    );
                }
            };

            window.matchMedia("(prefers-color-scheme: dark)")
                .addEventListener("change", () => {
                    if (selectedTheme === "system") {
                        applyTheme("system");
                    }
                });

            applyTheme(selectedTheme);
            window.csmTheme.setCompact(savedCompactMode);
        })();
    </script>

    <ImportMap />

    <link rel="icon" type="image/png" href="favicon.png" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>

    <OfflineSyncInitializer @rendermode="InteractiveServer" />

    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

        <ReconnectModal />

        <!-- Blazor -->
        <script src="@Assets["_framework/blazor.web.js"]"></script>

        <!-- CSM JavaScript -->
        <script src="js/siteMap.js"></script>
        <script src="js/download.js"></script>
        <script src="js/pdf.js"></script>
        <script src="js/offlineSync.js"></script>
        <script src="js/connectionState.js"></script>
        <script src="js/culture.js"></script>

    </body>

    </html>