@inherits LayoutComponentBase

<div class="page">
    <NavMenu IsNavOpen="_navOpen"
             IsNavOpenChanged="SetNavOpenAsync" />

    <main>
        <header class="top-row">
            <button type="button"
                    class="mobile-nav-toggle"
                    @onclick="ToggleNav"
                    aria-label="Open navigation menu"
                    aria-controls="app-navigation"
                    aria-expanded="@_navOpen">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <a class="top-row-brand" href="/dashboard">HBG CSM</a>
            <span class="top-row-title">Construction Site Management</span>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav()
    {
        _navOpen = !_navOpen;
    }

    private Task SetNavOpenAsync(bool isOpen)
    {
        _navOpen = isOpen;
        return Task.CompletedTask;
    }
}
