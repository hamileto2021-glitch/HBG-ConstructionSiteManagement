@using Microsoft.AspNetCore.Components.Routing
@using System.Linq
@using Microsoft.JSInterop
@using CSM.Web.Services

@inject IJSRuntime JS
@inject UserPreferencesService PreferencesService
@inject CSM.Web.Services.INotificationApiService NotificationService
@inject CSM.Web.Services.IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ILogger<NavMenu> Logger
@implements IDisposable

<button type="button"
        class="nav-backdrop @(IsNavOpen ? "show" : "")"
        @onclick="CloseNavAsync"
        aria-label="Close navigation menu"
        tabindex="@(IsNavOpen ? "0" : "-1")"></button>

<aside id="app-navigation"
       class="sidebar @(IsNavOpen ? "nav-open" : "")"
       aria-label="Application navigation">

    <div class="sidebar-header">
        <a class="navbar-brand" href="/dashboard" aria-label="HBG CSM home">
            <span class="brand-mark" aria-hidden="true">H</span>
            <span>HBG <strong>CSM</strong></span>
        </a>
        <span class="sidebar-tagline">CONSTRUCTION MANAGEMENT</span>
    </div>

    <!-- Scrollable Menu -->
    <div class="nav-scrollable" @onclick="CloseNavAsync">

        <nav class="@(_permissionsLoaded ? "" : "nav-loading")" aria-label="Main navigation">

            @if (HasAnyPermission(
                "Projects_View",
                "Sites_View",
                "Sites_Manage",
                "Procurement_MaterialRequest_View",
                "Procurement_PurchaseOrder_View",
                "Procurement_Inventory_View",
                "Equipment_View"))
            {
                <div class="section-title">
                    Construction Management
                </div>
            }

            <!-- Dashboard -->
            <div class="nav-item">
                <NavLink class="nav-link"
                         href="/dashboard"
                         Match="NavLinkMatch.All">
                    <span class="bi bi-speedometer2-nav-menu nav-icon" aria-hidden="true"></span>
                    <span class="nav-label">Dashboard</span>
                </NavLink>
            </div>

            <!-- Project Tracking -->
            @if (HasPermission("Projects_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link"
                             href="/project-tracking"
                             Match="NavLinkMatch.All">
                        <span class="bi bi-kanban-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Project Tracking</span>
                    </NavLink>
                </div>
            }



            <!-- Procurement -->
            @if (HasPermission("Procurement_MaterialRequest_View") ||
                 HasPermission("Procurement_PurchaseOrder_View") ||
                 HasPermission("Procurement_Vendor_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/procurement">
                        <span class="bi bi-box-seam-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Procurement</span>
                    </NavLink>
                </div>
            }

            <!-- Inventory -->
            @if (HasPermission("Procurement_Inventory_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/inventory">
                        <span class="bi bi-box-seam-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Inventory</span>
                    </NavLink>
                </div>
            }

            <!-- Equipment -->
            @if (HasPermission("Equipment_View") ||
                 HasPermission("Procurement_Inventory_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/equipment">
                        <span class="bi bi-truck-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Equipment</span>
                    </NavLink>
                </div>
            }

            @if (HasAnyPermission(
                "Users_View",
                "Audit_View",
                "HRM_Employee_View",
                "HRM_Contractor_View",
                "HRM_Payroll_View",
                "HRM_Attendance_View",
                "HRM_Leave_View",
                "Finance_Budget_View",
                "Finance_Expense_View",
                "Finance_Invoice_View",
                "Finance_Payment_View",
                "Finance_PettyCash_View",
                "Compliance_View",
                "Reports_View",
                "Reports_FinancialSummary_View",
                "Notifications_View"))
            {
                <hr class="my-2" />

                <div class="section-title">
                    Administration
                </div>
            }

            @if (HasPermission("Users_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/users">
                        <span class="bi bi-people-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Users</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("Users_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/roles">
                        <span class="bi bi-shield-lock-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Role Permissions</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("Audit_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/users/audit">
                        <span class="bi bi-clock-history-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">User Audit</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("HRM_Employee_View") ||
                 HasPermission("HRM_Contractor_View") ||
                 HasPermission("HRM_Payroll_View") ||
                 HasPermission("HRM_Attendance_View") ||
                 HasPermission("HRM_Leave_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/hr">
                        <span class="bi bi-person-badge-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">HR Management</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("Finance_Budget_View") ||
                 HasPermission("Finance_Expense_View") ||
                 HasPermission("Finance_Invoice_View") ||
                 HasPermission("Finance_Payment_View") ||
                 HasPermission("Finance_PettyCash_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link"
                             href="/finance/sites"
                             Match="NavLinkMatch.Prefix">
                        <span class="bi bi-wallet2-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Finance</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("Compliance_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/compliance">
                        <span class="bi bi-shield-check-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Compliance</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("Reports_View") ||
                 HasPermission("Reports_FinancialSummary_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/reports">
                        <span class="bi bi-bar-chart-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Reports</span>
                    </NavLink>
                </div>
            }

            @if (HasPermission("Notifications_View"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/notifications">
                        <span class="bi bi-bell-nav-menu nav-icon" aria-hidden="true"></span>
                        <span class="nav-label">Notifications</span>

                        @if (_unreadNotificationCount > 0)
                        {
                            <span class="badge bg-danger notification-badge">
                                @_unreadNotificationCount
                            </span>
                        }
                    </NavLink>
                </div>
            }

            <div class="nav-item">
                <NavLink class="nav-link" href="/settings">
                    <span class="bi bi-gear-nav-menu nav-icon" aria-hidden="true"></span>
                    <span class="nav-label">Settings & Privacy</span>
                </NavLink>
            </div>

        </nav>

    </div>

    <!-- Sign Out -->
    <div class="signout">
        <button type="button" class="nav-link signout-btn" @onclick="SignOutAsync" disabled="@_signingOut">
            <span class="bi bi-box-arrow-right-nav-menu nav-icon" aria-hidden="true"></span>
            <span>@(_signingOut ? "Signing out..." : "Sign Out")</span>
        </button>
    </div>
</aside>

@code
{
    private int _unreadNotificationCount;
    private bool _permissionsLoaded;
    private bool _rememberNavigation;
    private bool _navigationPreferenceLoaded;
    private string? _navigationStorageKey;
    private bool _signingOut;

    [Parameter]
    public bool IsNavOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsNavOpenChanged { get; set; }

    private IReadOnlyCollection<string> _permissions = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _unreadNotificationCount =
                await NotificationService.GetUnreadCountAsync();
        }
            catch (Exception ex)
            {
                _unreadNotificationCount = 0;
                Logger.LogWarning(ex, "Unable to load the unread notification count for the navigation menu.");
            }

        try
        {
            _permissions = await AuthService.GetPermissionsAsync();

        }
        finally
        {
            _permissionsLoaded = true;
        }

        NavigationManager.LocationChanged += OnLocationChanged;
        _ = RefreshLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeRememberNavigationAsync();
        }
    }

    private async Task InitializeRememberNavigationAsync()
    {
        var userId = await AuthService.GetCurrentUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            _navigationPreferenceLoaded = true;
            return;
        }

        _navigationStorageKey = $"csm:last-route:{userId}";

        var preferences = await PreferencesService.GetAsync();
        _rememberNavigation = preferences?.RememberNavigation ?? false;

        _navigationPreferenceLoaded = true;

        if (!_rememberNavigation)
        {
            await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                _navigationStorageKey);

            return;
        }

        var currentRoute =
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        // Restore only when entering the application root.
        if (!string.IsNullOrWhiteSpace(currentRoute))
            return;

        var savedRoute = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            _navigationStorageKey);

        if (string.IsNullOrWhiteSpace(savedRoute))
            return;

        // Only restore an internal application route.
        if (savedRoute.StartsWith('/') ||
            savedRoute.StartsWith('\\') ||
            Uri.TryCreate(savedRoute, UriKind.Absolute, out _))
        {
            return;
        }

        var savedPath = savedRoute.Split('?', '#')[0];

        if (string.IsNullOrWhiteSpace(savedPath) ||
            savedPath.Equals("login", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        NavigationManager.NavigateTo(savedRoute);
    }

    // Re-check the unread count after every page change, and every 30 seconds
    // in between, so the bell shows new notifications without a reload.
    private readonly CancellationTokenSource _cts = new();

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        _ = RefreshUnreadCountAsync();
        _ = SaveLastVisitedPageAsync(e.Location);
    }

    private async Task SaveLastVisitedPageAsync(string location)
    {
        if (!_navigationPreferenceLoaded ||
            string.IsNullOrWhiteSpace(_navigationStorageKey))
        {
            return;
        }

        try
        {
            // Re-read the preference so changes made in Settings
            // take effect without requiring a new sign-in.
            var preferences = await PreferencesService.GetAsync();

            _rememberNavigation =
                preferences?.RememberNavigation ?? false;

            if (!_rememberNavigation)
            {
                await JS.InvokeVoidAsync(
                    "localStorage.removeItem",
                    _navigationStorageKey);

                return;
            }

            var route = NavigationManager.ToBaseRelativePath(location);

            if (string.IsNullOrWhiteSpace(route))
                return;

            var path = route.Split('?', '#')[0];

            if (path.Equals("login", StringComparison.OrdinalIgnoreCase) ||
                path.Equals("logout", StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                _navigationStorageKey,
                route);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected during navigation.
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await RefreshUnreadCountAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Menu is going away.
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var count = await NotificationService.GetUnreadCountAsync();

            if (count != _unreadNotificationCount)
            {
                _unreadNotificationCount = count;
                await InvokeAsync(StateHasChanged);
            }
        }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Unable to refresh the unread notification count; retaining the last known value.");
            }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

    private bool HasPermission(string permission)
    {
        return _permissions.Contains(permission);
    }

    private bool HasAnyPermission(params string[] permissions)
    {
        return permissions.Any(HasPermission);
    }

    private Task CloseNavAsync()
    {
        return IsNavOpen ? IsNavOpenChanged.InvokeAsync(false) : Task.CompletedTask;
    }

    private async Task SignOutAsync()
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;

        try
        {
            await AuthService.LogoutAsync();
        }
        finally
        {
            _signingOut = false;
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
